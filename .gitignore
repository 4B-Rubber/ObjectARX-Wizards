# --- Multi-year wizard work: tooling, scratch and build outputs ---
# Portable WiX 3.14 toolchain used by the MSI/bundle builds (large, download on demand)
.tools/

# Scratch projects produced by the VSIX template smoke tests
_E2EGen/

# WiX toolchain outputs (candle .wixobj / light .wixpdb), any project. One .wixobj was checked in
# upstream; keep every one of them out from now on.
*.wixobj
*.wixpdb

# MSBuild binary log
*.binlog

# The .wixproj PostBuildEvent zips the built MSI next to the project; that is a build output too
ObjectARXWizardsInstaller/ObjectARXWizard.zip

# Installer artifacts rebuilt from source. ObjectARXMultiVersionWizards.vsix is a build output now: it is written into the build root
# and the copies handed to users live there too. Nothing in this block is committed any more.
/ObjectARXMultiVersionWizards.msi
/ObjectARXMultiVersionWizardsSetup.exe
/ObjectARXMultiVersionWizards.vsix
/ObjectARXMultiVersionWizards-*.exe
# ObjectARXWizardsInstaller\make.bat links its own MSI beside the sources. The name is deliberately
# year-neutral - this is a multi-year product, so no artifact may be tied to a single release.
/ObjectARXWizardsInstaller/ObjectARXMultiVersionWizards.msi
# Inno Setup line: built by InnoSetupInstaller\ObjectARXMultiVersionWizards.iss
/InnoSetupInstaller/Output/

# In-repo copies of the built installers (hand-out only, never uploaded)
/dist/

# Agent workspace state
.trae/
# Local-only agent supplement: readable by any agent on this machine, but not uploaded
AGENTS.local.md
