<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current"
  xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
[!output ARX_CONFIG_XML]  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ArxAppType>[!output PRJ_TYPE_APP]</ArxAppType>
    <RDS>[!output RDS_SYMB]</RDS>
    <ProjectGuid>{[!output PROJECT_GUID]}</ProjectGuid>
    <!--For Visual Studio 2019 and newer, you can specify the most recent Windows 10 SDK by using a value of 10.0-->
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <!-- Extract the target year (e.g. 2026) and the debug suffix from configurations like "2026d" -->
  <PropertyGroup>
    <ArxYear Condition="'$(Configuration)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(Configuration)', '([!output ARX_YEAR_REGEX])').Value)</ArxYear>
    <ConfigSuffix Condition="'$(Configuration)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(Configuration)', 'd$').Value)</ConfigSuffix>
    <IsDebug Condition="'$(ConfigSuffix)' == 'd'">true</IsDebug>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    [!output ARX_CLR_XML]
    <UseOfMfc>[!output ARX_MFC_SUPPORT]</UseOfMfc>
    <UseOfAtl>[!output ARX_ATL_SUPPORT]</UseOfAtl>
[!output ARX_TOOLSET_XML]  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <UseDebugLibraries Condition="'$(IsDebug)' == 'true'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(IsDebug)' != 'true'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(IsDebug)' != 'true'">true</WholeProgramOptimization>
    <WholeProgramOptimization Condition="'$(IsDebug)' == 'true'">false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Condition="'$(ArxYear)' != ''" Project="[!output ARX_PROPS_DIR]Autodesk.arx-$(ArxYear).props" />
  </ImportGroup>
  <PropertyGroup Condition="'$(ArxYear)' != ''">
    <TargetName Condition="'$(RDS)' != ''">$(RDS)$(ProjectName)$(ArxYear)</TargetName>
    <TargetName Condition="'$(RDS)' == ''">$(ProjectName)$(ArxYear)</TargetName>
    [!if DOTNET_MODULE]
    <TargetExt>.dll</TargetExt>
    [!endif]
    <IntDir>$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup />
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>StdAfx.h</PrecompiledHeaderFile>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">_WIN64;[!output ARX_OMF_DEFS]%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='Win32'">WIN32;[!output ARX_OMF_DEFS]%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(UseOfMfc)'=='Dynamic'">_AFXEXT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <ForceConformanceInForLoopScope>true</ForceConformanceInForLoopScope>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <!-- Added to avoid Narrow conversion warnings introduced in VS2015 /Wv:xx[.yy[.zzzzz],  is CL version -->
      <AdditionalOptions>/Wv:17.00.61030[!output ARX_OMF_ZM] %(AdditionalOptions)</AdditionalOptions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
    </Link>
    <Midl>
      <!-- The .rc references $(RDS)$(ProjectName).tlb from $(IntDir); keep the year suffix off the tlb name -->
      <TypeLibraryName>$(IntDir)$(RDS)$(ProjectName).tlb</TypeLibraryName>
    </Midl>
  </ItemDefinitionGroup>
  [!if DOTNET_MODULE]
  <!-- .NET Framework mixed modules (up to 2024): the Autodesk net props do not
       reference System.Core, required by mgdinterop.h (System.Dynamic). -->
  <ItemGroup Condition="[!output ARX_NETFW_CONDITION]">
    <Reference Include="System.Core" />
  </ItemGroup>
  [!endif]
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
