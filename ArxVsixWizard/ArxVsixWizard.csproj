<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>ArxVsixWizard</RootNamespace>
    <AssemblyName>ArxVsixWizard</AssemblyName>
    <UseWPF>true</UseWPF>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.2.10</Version>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <CreateVsixContainer>true</CreateVsixContainer>
    <!-- The package (Commands\ArxWizardPackage.cs) needs its registration attributes
         emitted as a .pkgdef or Visual Studio never learns the package exists. -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <EnableContentIncludeInVsix>true</EnableContentIncludeInVsix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageReference Include="Microsoft.VisualStudio.TemplateWizardInterface" Version="17.10.40170" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; buildMultiTargeting; buildTransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded wizard templates (rendered by the C# renderer) -->
    <EmbeddedResource Include="Templates\ArxApp\*" LogicalName="ArxApp.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Templates\OmfApp\*" LogicalName="OmfApp.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Packaging\ProjectTemplates\VC\1033\ArxApp\ArxProject.vcxproj" LogicalName="ArxApp.Skeleton.vcxproj" />
    <EmbeddedResource Include="Packaging\ProjectTemplates\VC\1033\OmfApp\OmfProject.vcxproj" LogicalName="OmfApp.Skeleton.vcxproj" />
    <!-- Class/item wizard templates (rendered by the C# renderer). -->
    <EmbeddedResource Include="Items\NetWrapper\Templates\*" LogicalName="ArxWizNetWrapper.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Items\Jig\Templates\*" LogicalName="ArxWizJig.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Items\CustomObject\Templates\*" LogicalName="ArxWizCustomObject.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Items\Reactors\Templates\*" LogicalName="ArxWizReactors.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Items\MfcSupport\Templates\*" LogicalName="ArxWizMfcSupport.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Items\AtlComWrapper\Templates\*" LogicalName="ArxWizAtlComWrapper.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Items\AtlDynProp\Templates\*" LogicalName="ArxWizAtlDynProp.%(Filename)%(Extension)" />
    <!-- XML class tables shared by the wizards above (reactors.xml, DbxObjects.xml, MfcSupport.xml). -->
    <EmbeddedResource Include="Items\Data\*" LogicalName="ArxWizData.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK default glob would pull in the TemplateSmokeTest project files
         (including its generated AssemblyInfo.cs under TemplateSmokeTest\obj). -->
    <Compile Remove="TemplateSmokeTest\**" />
    <EmbeddedResource Remove="TemplateSmokeTest\**" />
    <None Remove="TemplateSmokeTest\**" />
    <Content Remove="TemplateSmokeTest\**" />
    <Page Remove="TemplateSmokeTest\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the assembly as the "Menus.ctmenu" resource that
         ProvideMenuResource("Menus.ctmenu", 1) points at. -->
    <VSCTCompile Include="Commands\ArxWizardCommands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="source.extension.vsixmanifest" />
    <!-- The classic line ships the classic wizards: the .vsz/.vsdir entries the installer copies into
         vcprojects\Autodesk are what New Project lists, and the VCAddClass item wizards are what
         Add Class lists. The VSIX is installed on this line only because that install is what makes
         Visual Studio rebuild its wizard list (see InnoSetupInstaller\ObjectARXMultiVersionWizards.iss),
         so no template *definition* goes into the container: VS registers a template from its
         .vstemplate, and without one there is nothing to list. Everything else stays, so the manifest
         asset paths keep pointing at folders that exist in the package, and
         Packaging\ProjectTemplates\**\*.vcxproj stays available as the embedded skeleton above.
         Templates must live under a folder named ProjectTemplates in the VSIX; VS only registers
         project templates discovered there. Layout: ProjectTemplates\VC\1033\<name>. -->
    <Content Include="Packaging\ProjectTemplates\**\*" Exclude="Packaging\ProjectTemplates\**\*.vstemplate" Link="ProjectTemplates\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Same rule for item templates: VS only registers them when they live under
         a folder named ItemTemplates in the VSIX. Layout: ItemTemplates\VC\<category>\1033\<name>. -->
    <Content Include="Packaging\ItemTemplates\**\*" Exclude="Packaging\ItemTemplates\**\*.vstemplate" Link="ItemTemplates\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
