<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <!-- This line ships the classic wizards: the item entries come from the installer's
       vcprojectitems\ObjectARX (.vsz) and the project entries from vcprojects\Autodesk, so the
       command table is deliberately empty - the package keeps its menu resource
       (ProvideMenuResource) without offering anything in the IDE. Adding a command back means
       adding its Group/Button here plus the handler in ArxWizardPackage.InitializeAsync. -->
  <Symbols>
    <GuidSymbol name="guidArxWizardPackage" value="{9E4F2C71-3B5A-4D68-8F1C-2A7B6D0E5F93}"/>
  </Symbols>
</CommandTable>
