<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>ObjectDBX Custom Object Class</Name>
    <Description>Creates a class derived from an ObjectDBX class (custom entity). The protocol level follows the chosen base class.</Description>
    <Icon>CustomObject.ico</Icon>
    <ProjectType>VC</ProjectType>
    <TemplateID>ArxWizard.Item.CustomObject</TemplateID>
    <TemplateGroupID>VC-Native</TemplateGroupID>
    <DefaultName>MyObject</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Disabled</LocationField>
    <ShowByDefault>true</ShowByDefault>
    <SortOrder>230</SortOrder>
  </TemplateData>
  <TemplateContent>
    <!-- The wrapper files only carry $ArxWrapNContent$; RunStarted injects both the
         content and the target file name (renaming is not possible otherwise). -->
    <ProjectItem ReplaceParameters="true" TargetFileName="$ArxWrap0File$">Wrap0.txt</ProjectItem>
    <ProjectItem ReplaceParameters="true" TargetFileName="$ArxWrap1File$">Wrap1.txt</ProjectItem>
  </TemplateContent>
  <WizardExtension>
    <Assembly>ArxVsixWizard, Version=0.3.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>ArxVsixWizard.Items.CustomObjectItemWizard</FullClassName>
  </WizardExtension>
</VSTemplate>