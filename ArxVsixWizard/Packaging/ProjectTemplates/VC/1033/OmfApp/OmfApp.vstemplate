<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005"
            xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
  <TemplateData>
    <Name>ObjectARX/DBX Application with OMF Support (Multi-Version)</Name>
    <Description>Creates an ObjectARX or ObjectDBX application with optional OMF / MAP vertical SDK support. AutoCAD 2014-2027.</Description>
    <Icon>OmfApp.ico</Icon>
    <ProjectType>VC</ProjectType>
    <SortOrder>1001</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>OmfApp</DefaultName>
    <ProvideDefaultName>false</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
  </TemplateData>
  <TemplateContent>
    <Project File="OmfProject.vcxproj" TargetFileName="$projectname$.vcxproj" ReplaceParameters="true" />
  </TemplateContent>
  <WizardExtension>
    <Assembly>ArxVsixWizard, Version=0.2.3.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>ArxVsixWizard.OmfProjectWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
