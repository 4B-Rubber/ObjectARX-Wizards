<Window x:Class="ArxVsixWizard.UI.ItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ObjectARX Wizard"
        Width="560" Height="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" MinWidth="480" MinHeight="320"
        ShowInTaskbar="False" FontSize="12">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="OkButton" Content="Finish" Width="90" Height="28" Margin="0,0,8,0" Click="OnOk" IsDefault="True"/>
        <Button Content="Cancel" Width="90" Height="28" IsCancel="True"/>
      </StackPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Name="ErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TextBlock DockPanel.Dock="Top" Name="DescriptionText" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="Gray"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Name="FieldsPanel"/>
    </ScrollViewer>
  </DockPanel>
</Window>