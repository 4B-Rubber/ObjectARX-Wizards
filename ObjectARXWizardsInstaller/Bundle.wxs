<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension">

  <!-- One double-click launcher: a single UAC prompt covers the per-machine MSI, then the VSIX is
       installed for the current user by install-vsix.cmd (which locates VSIXInstaller.exe).
       The bundle is per-machine because the MSI is; the VSIX must not be, hence the .cmd hop. -->
  <Bundle Name="ObjectARX Multi-Year Wizards (2010-2027)"
          Version="26.2.0"
          Manufacturer="Autodesk"
          UpgradeCode="{956924F4-FEFE-4815-B486-A219B4406CCB}">

    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.HyperlinkLicense">
      <bal:WixStandardBootstrapperApplication LicenseUrl="http://www.autodesk.com/developautocad"
                                              SuppressOptionsUI="yes" />
    </BootstrapperApplicationRef>

    <Chain>
      <!-- DisplayInternalUI: without it Burn runs the chain silently, so the MSI's own dialog
           chain (welcome, year selection, props folder) never appears and the install silently
           falls back to the default years. The standard bootstrapper has no page of its own for
           those choices, so it has to hand over to the MSI UI. -->
      <MsiPackage Id="ArxWizardsMsi"
                  SourceFile="bin\Release\ObjectARXWizard.msi"
                  DisplayInternalUI="yes"
                  Vital="yes" />

      <!-- Permanent: the extension is removed from Visual Studio's Extensions dialog, not by the bundle.
           The launcher must build an executable, which is why Burn cannot just call cmd.exe here. -->
      <ExePackage Id="ArxWizardsVsix"
                  Vital="no"
                  Permanent="yes"
                  SourceFile="Bundle\ArxWizardsVsixSetup.exe"
                  InstallCommand='"[WixBundleExecutePackageCacheFolder]ObjectARXMultiYearWizards.vsix"'
                  DetectCondition="false">
        <Payload SourceFile="..\ObjectARXMultiYearWizards.vsix" Compressed="yes" />
      </ExePackage>
    </Chain>
  </Bundle>
</Wix>