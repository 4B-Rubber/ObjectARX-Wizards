<?xml version="1.0" encoding="utf-8"?>
<!-- Chinese strings for the Burn bootstrapper, translated from the WiX shipping HyperlinkTheme.wxl
     (SDK\themes\HyperlinkTheme.wxl) that WixStandardBootstrapperApplication uses by default. The MSI
     it chains is Chinese too, so the launcher has to be - otherwise the first window a user sees is
     English and the wizard behind it is Chinese.

     Keep the &amp; mnemonics: they are what Alt+letter activates. -->
<WixLocalization Culture="zh-CN" Language="2052" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="Caption">[WixBundleName] 安装程序</String>
  <String Id="Title">[WixBundleName]</String>
  <String Id="InstallHeader">欢迎</String>
  <String Id="InstallMessage">安装程序会把 [WixBundleName] 安装到本机。单击“安装”继续，单击“选项”指定安装目录，或单击“关闭”退出。</String>
  <String Id="InstallVersion">版本 [WixBundleVersion]</String>
  <String Id="ConfirmCancelMessage">确定要取消吗？</String>
  <String Id="ExecuteUpgradeRelatedBundleMessage">上一个版本</String>
  <String Id="HelpHeader">安装帮助</String>
  <String Id="HelpText">/install | /repair | /uninstall | /layout [目录] - 安装、修复、卸载，或在指定目录创建一份完整的本地副本。默认动作是安装。

/passive | /quiet - 只显示最小界面且不提示，或完全不显示界面也不提示。默认会显示界面和全部提示。

/norestart   - 不尝试重新启动。默认在重新启动前会先提示。

/log log.txt - 把日志写到指定文件。默认在 %TEMP% 下创建日志文件。</String>
  <String Id="HelpCloseButton">关闭(&amp;C)</String>
  <String Id="InstallLicenseLinkText">[WixBundleName] &lt;a href="#"&gt;许可条款&lt;/a&gt;。</String>
  <String Id="InstallAcceptCheckbox">我同意许可条款和条件(&amp;A)</String>
  <String Id="InstallOptionsButton">选项(&amp;O)</String>
  <String Id="InstallInstallButton">安装(&amp;I)</String>
  <String Id="InstallCloseButton">关闭(&amp;C)</String>
  <String Id="OptionsHeader">安装选项</String>
  <String Id="OptionsLocationLabel">安装位置：</String>
  <String Id="OptionsBrowseButton">浏览(&amp;B)</String>
  <String Id="OptionsOkButton">确定(&amp;O)</String>
  <String Id="OptionsCancelButton">取消(&amp;C)</String>
  <String Id="ProgressHeader">安装进度</String>
  <String Id="ProgressLabel">正在处理：</String>
  <String Id="OverallProgressPackageText">正在初始化...</String>
  <String Id="ProgressCancelButton">取消(&amp;C)</String>
  <String Id="ModifyHeader">修改安装</String>
  <String Id="ModifyRepairButton">修复(&amp;R)</String>
  <String Id="ModifyUninstallButton">卸载(&amp;U)</String>
  <String Id="ModifyCloseButton">关闭(&amp;C)</String>
  <String Id="SuccessRepairHeader">修复已成功完成</String>
  <String Id="SuccessUninstallHeader">卸载已成功完成</String>
  <String Id="SuccessInstallHeader">安装已成功完成</String>
  <String Id="SuccessHeader">安装成功</String>
  <String Id="SuccessLaunchButton">启动(&amp;L)</String>
  <String Id="SuccessRestartText">必须重新启动计算机才能使用本软件。</String>
  <String Id="SuccessRestartButton">重新启动(&amp;R)</String>
  <String Id="SuccessCloseButton">关闭(&amp;C)</String>
  <String Id="FailureHeader">安装失败</String>
  <String Id="FailureInstallHeader">安装失败</String>
  <String Id="FailureUninstallHeader">卸载失败</String>
  <String Id="FailureRepairHeader">修复失败</String>
  <String Id="FailureHyperlinkLogText">一个或多个问题导致安装失败。请解决这些问题后重试。详情见&lt;a href="#"&gt;日志文件&lt;/a&gt;。</String>
  <String Id="FailureRestartText">必须重新启动计算机以完成回滚。</String>
  <String Id="FailureRestartButton">重新启动(&amp;R)</String>
  <String Id="FailureCloseButton">关闭(&amp;C)</String>
  <String Id="FilesInUseHeader">正在使用的文件</String>
  <String Id="FilesInUseLabel">以下应用程序正在使用需要更新的文件：</String>
  <String Id="FilesInUseCloseRadioButton">关闭这些应用程序，并在安装后尝试重新启动它们(&amp;A)。</String>
  <String Id="FilesInUseDontCloseRadioButton">不关闭这些应用程序(&amp;D)。需要重新启动计算机。</String>
  <String Id="FilesInUseOkButton">确定(&amp;O)</String>
  <String Id="FilesInUseCancelButton">取消(&amp;C)</String>
  <String Id="ErrorFailNoActionReboot">需要重新启动系统，因此未执行任何操作。</String>
</WixLocalization>