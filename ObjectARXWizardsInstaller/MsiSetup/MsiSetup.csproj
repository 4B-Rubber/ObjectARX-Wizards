<?xml version="1.0" encoding="utf-8"?>
<!-- Small helper the Burn bundle runs instead of chaining the MSI directly. AnyCPU so that
     SpecialFolder.System resolves to the 64-bit System32: the MSI is x64. -->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <OutputPath>..\Bundle\</OutputPath>
    <AssemblyName>ArxWizardsMsiSetup</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="MsiSetup.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>