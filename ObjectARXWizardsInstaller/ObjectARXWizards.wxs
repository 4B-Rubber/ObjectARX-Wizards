<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

	<?define RTMProductVersion = "18.0.0"?> <!-- The first one - do not edit -->
	<?define ProductVersion = "0.2.4"?>
    <!--UpgradeCode GUID "{7092FED1-4FCC-4565-A8B6-44DCD4583F92}"?> from a retired per-year release-->
	<?define UpgradeCode = "{A5569809-8D74-410A-83C3-F3AB0C4E2F80}"?>
	<!--Product GUID "{8046A89B-41DD-4779-A741-64A601603076}"?> from a retired per-year release-->
	<!--ProductCode from a retired per-year release-->
	<!--<?define ProductCode= "{AB65E222-EAB0-494E-AC65-07BF30A915F3}"?>-->	
	<!--ProductCode from a retired per-year release-->
	<!--<?define ProductCode= "{2F8A7D4E-B3C6-4E91-A8F2-7D5E9C1A6B48}"?>-->
  <!--ProductCode for 0.1.1, the first build of the restarted numbering.-->
  <!--<?define ProductCode= "{922142B3-22ED-4543-A8AB-E2AF5820105F}"?>-->
  <!--ProductCode for 0.1.2, which brought the MSI in line with the Inno line: one Autodesk root
      instead of separate SDK/AutoCAD roots and no separate AutoCAD location, a selectable 64-bit
      install folder, the property sheet folder following it, an empty-by-default RDS, and a Chinese
      wizard.-->
  <!--<?define ProductCode= "{D8C4DE84-665B-4442-85C0-2DE1C293EBE0}"?>-->
  <!--ProductCode for 0.1.3, which carries the VSIX fixes (the wizard templates named a 26.x assembly,
      and new resource ids were defined below the resource editor's bookkeeping block).-->
  <!--<?define ProductCode= "{2D2AA7F2-1804-4816-ADEF-1932D00CB77C}"?>-->
  <!--ProductCode for 0.1.4, which renames the product to Multi-Version, stops shipping the
      authoring machine's experimental property sheets, and remembers the previous install folder.-->
  <!--<?define ProductCode= "{4E9C1F38-6A2D-4B07-9C51-83D7E0A4B6F2}"?>-->
  <!--ProductCode for 0.1.5, which carries the real wizard icons (the VSIX shipped a 60-byte stub
      next to every template, so the Add Class and New Project lists had no visual distinction).-->
  <!--<?define ProductCode= "{A7F2C4E8-5D31-49B6-8E07-C62B1F4A9D53}"?>-->
  <!--ProductCode for 0.1.6, which drops the retired "Trial" configuration from the property sheets
      the installer generates.-->
  <!--<?define ProductCode= "{C31D7B05-9E64-4A2F-8B7D-5F0A6E2C9D14}"?>-->
  <!--ProductCode for 0.1.7, whose project templates set ProvideDefaultName=false so VS does not run
      the NewProjectDialog.UpdateNameField -> GenerateItemName call that crashes the IDE (see docs 18).
      ProductVersion and ProductCode have to move together, and both have to move for every build that
      is meant to go on top of an existing install: reusing this code with a different version is
      rejected by msiexec with error 1638 ("another version of this product is already installed"), and
      reusing it with the same version can only ever be a repair of the package that is already there -
      it would show the maintenance page instead of upgrading.-->
  <!--<?define ProductCode= "{E8B46D29-7C15-4F83-A6E2-9D5B3C71F0A8}"?>-->
<!--ProductCode for 0.2.4, which drops the two classic .vsz project wizards from this line (the VSIX
	ships those project templates) and follows the Inno line's payload.-->
<?define ProductCode= "{7C4E9A31-58D2-4F60-9B7E-6A3D1F8C2B45}"?>
  

  <Product
		Id="$(var.ProductCode)"
		Codepage="936" 
		Language="2052" 
		Manufacturer="Autodesk" 
		Name="ObjectARX Multi-Version Wizards" 
		UpgradeCode="$(var.UpgradeCode)" 
		Version="$(var.ProductVersion)"
	>
	<Package 
		Id='*'
		Comments="Autodesk Developer Network" 
		Compressed="yes"
		InstallPrivileges="elevated" 			
		InstallScope="perMachine"
		InstallerVersion="300" 
		Languages="2052" 
		Manufacturer="by Cyrille Fauvel, Madhukar Moogala" 
		Platform="x64"
	/>

	<Media Id="1" Cabinet="ObjectARXWizards.cab" EmbedCab="yes" CompressionLevel="high" VolumeLabel="DISK #1'" />
	<Icon Id="ObjectARXWizards.ico" SourceFile="..\_Installs\VC\vcprojects\Autodesk\ArxAppWiz.ico" />
	
	<?include directory.wxi ?>
	<?include feature.wxi ?>
	<?include property.wxi ?>
	<?include UI.wxi ?>

	<!-- No launch condition on Visual Studio: the WixVSExtension only ever resolves VS2022, and
	     CA_FindVsRootFolder fills in a VS2026 (or other) install when there is no VS2022, or leaves
	     the property at TARGETDIR - which the tree's components test for and skip - when the machine
	     has no Visual Studio at all. -->
	
  <!--For Debugging-->
  <Property Id="WIX_CA_LOGGING" Value="0" />
  <!--End-->
	<Binary Id="ID_CABinary" SourceFile="Binary\ArxWizCustomAction.CA.dll" />
	<CustomAction Id="CA_PatchVSFiles" BinaryKey="ID_CABinary" DllEntry="PatchVSFiles" Execute="immediate" Return="check" />
	<!-- VS2022_ROOT_FOLDER comes from the WixVSExtension and is only ever set for VS2022; on a
	     machine with another version this fills the gap before CostFinalize resolves the tree. -->
	<CustomAction Id="CA_FindVsRootFolder" BinaryKey="ID_CABinary" DllEntry="FindVsRootFolder" Execute="immediate" Return="check" />
	<!-- Mirrors the registration files into every other Visual Studio and rewrites the wizard engine
	     ProgID to that version. Return=ignore: a machine where one folder cannot be written to is
	     still a working install for the Visual Studio the MSI itself targets. -->
	<CustomAction Id="CA_DeployWizardsToOtherVS" BinaryKey="ID_CABinary" DllEntry="DeployWizardsToOtherVS" Execute="immediate" Return="ignore" />
	<Property Id="VSList" Value="VS2022_ROOT_FOLDER" />
	<Property Id="ArxWizList" Value="ArxAppWiz;ArxAppWizOMF;ArxAtlWizComWrapper;ArxAtlWizDynProp;ArxWizCustomObject;ArxWizJig;ArxWizMFCSupport;ArxWizNETWrapper;ArxWizReactors" />
	<CustomAction Id="CA_PatchHTMLWizFiles" BinaryKey="ID_CABinary" DllEntry="PatchHTMLWizFiles" Execute="immediate" Return="check" />
	<!-- The legacy HTML wizard hardcodes the props folder in arxCommon.js; rewrite it to the chosen one. -->
	<CustomAction Id="CA_PatchArxCommonJs" BinaryKey="ID_CABinary" DllEntry="PatchArxCommonJsFiles" Execute="immediate" Return="check" />
	
	<!-- Install-time generation of Autodesk.arx-<year>.props. A deferred custom action only receives
	     CustomActionData, and a type-51 property-set action is capped at 255 characters in the MSI
	     CustomAction table - far too small for four folder paths plus 16 year flags. PrepArxPropsData
	     assembles the data at run time instead (it runs during script generation, before these are
	     scheduled). -->
	<CustomAction Id="CA_PrepArxPropsData" BinaryKey="ID_CABinary" DllEntry="PrepArxPropsData" Execute="immediate" Return="check" />
	<!-- First install only: ticks DefaultYears (2020/2024/2026/2027), so an upgrade keeps exactly the
	     previous selection. -->
	<CustomAction Id="CA_DefaultArxYears" BinaryKey="ID_CABinary" DllEntry="DefaultArxYears" Execute="immediate" Return="check" />
	<!-- SdkForm's All / None / Invert / Compatible and its year check boxes are pure declarative
	     publishes: a custom action that rewrote YEAR_* could not repaint the check boxes, which is
	     what made those buttons look dead. BuildYearsSummary runs from SdkForm's Next, before
	     YearSummaryForm re-reads the selection. -->
	<CustomAction Id="CA_BuildYearsSummary" BinaryKey="ID_CABinary" DllEntry="BuildYearsSummary" Execute="immediate" Return="check" />
	<!-- MaintenanceForm "change the target years and reinstall". Also DoAction-only. -->
	<CustomAction Id="CA_TickDetectedArxYears" BinaryKey="ID_CABinary" DllEntry="TickDetectedArxYears" Execute="immediate" Return="check" />
	<CustomAction Id="CA_CREATEARXPROPS" BinaryKey="ID_CABinary" DllEntry="CreateArxProps" Execute="deferred" Impersonate="no" Return="ignore" />
	<CustomAction Id="CA_CLEANUPUNSELECTEDARXPROPS" BinaryKey="ID_CABinary" DllEntry="CleanupUnselectedArxProps" Execute="deferred" Impersonate="no" Return="ignore" />
	<CustomAction Id="CA_REMOVEARXPROPS" BinaryKey="ID_CABinary" DllEntry="RemoveArxProps" Execute="deferred" Impersonate="no" Return="ignore" />
	
	<InstallUISequence> <!-- msiexec /i -->
		<Custom Action="CA_TARGETDIR_PREV" After="AppSearch"><![CDATA[TARGETDIR="" AND INSTALLDIR_PROBE<>""]]></Custom>
		<Custom Action="CA_TARGETDIR" After="CA_TARGETDIR_PREV"><![CDATA[TARGETDIR=""]]></Custom>
		<Custom Action="CA_DefaultPropsDir" After="CA_TARGETDIR"><![CDATA[ARXPROPSDIR=""]]></Custom>
		<Custom Action="CA_DefaultPropsDirAuto" After="CA_DefaultPropsDir"><![CDATA[ARXPROPSDIR_AUTO=""]]></Custom>
		<Custom Action="CA_DefaultArxRoot" After="AppSearch"><![CDATA[ARXROOT=""]]></Custom>
		<Custom Action="CA_DefaultArxYears" After="AppSearch"></Custom>
		<Custom Action="CA_FindVsRootFolder" Before="CostInitialize"></Custom>
		<Show Dialog="WelcomeForm" Before="CostFinalize"><![CDATA[Installed="" AND NOT RESUME]]></Show>
		<Show Dialog="ResumeForm" Before="CostFinalize"><![CDATA[Installed="" AND RESUME]]></Show>
		<Show Dialog="MaintenanceForm" Before="CostFinalize"><![CDATA[Installed<>""]]></Show>
		<Show Dialog="ProgressForm" Before="ExecuteAction" />
		
		<Show Dialog="FatalErrorForm" OnExit="error"><![CDATA[NOT HideFatalErrorForm]]></Show>
		<Show Dialog="UserExitForm" OnExit="cancel" />
		<Show Dialog="FinishedForm" OnExit="success" />		
		<Custom Action="PreventDowngrading" After="FindRelatedProducts"><![CDATA[NEWERPRODUCTFOUND]]></Custom>
	</InstallUISequence>
	<InstallExecuteSequence>
		<Custom Action="CA_TARGETDIR_PREV" Before="CostInitialize"><![CDATA[TARGETDIR="" AND INSTALLDIR_PROBE<>""]]></Custom>
		<Custom Action="CA_TARGETDIR" After="CA_TARGETDIR_PREV"><![CDATA[TARGETDIR=""]]></Custom>
		<Custom Action="CA_DefaultPropsDir" After="CA_TARGETDIR"><![CDATA[ARXPROPSDIR=""]]></Custom>
		<Custom Action="CA_DefaultPropsDirAuto" After="CA_DefaultPropsDir"><![CDATA[ARXPROPSDIR_AUTO=""]]></Custom>
		<Custom Action="CA_DefaultArxRoot" Before="CostInitialize"><![CDATA[ARXROOT=""]]></Custom>
		<Custom Action="CA_DefaultArxYears" Before="CostInitialize"></Custom>
		<Custom Action="CA_FindVsRootFolder" Before="CostInitialize"></Custom>
		<Custom Action="CA_PatchVSFiles" After="InstallFinalize"><![CDATA[REINSTALL OR NOT Installed]]></Custom>
		<Custom Action="CA_PatchHTMLWizFiles" After="InstallFinalize"><![CDATA[REINSTALL OR NOT Installed]]></Custom>
		<Custom Action="CA_PatchArxCommonJs" After="InstallFinalize"><![CDATA[REINSTALL OR NOT Installed]]></Custom>
		<Custom Action="CA_DeployWizardsToOtherVS" After="CA_PatchArxCommonJs"><![CDATA[REINSTALL OR NOT Installed]]></Custom>
		<Custom Action="CA_PrepArxPropsData" After="InstallInitialize"></Custom>
		<Custom Action="CA_CREATEARXPROPS" After="InstallFiles"><![CDATA[NOT Installed OR REINSTALL]]></Custom>
		<Custom Action="CA_CLEANUPUNSELECTEDARXPROPS" After="CA_CREATEARXPROPS"><![CDATA[NOT Installed OR REINSTALL]]></Custom>
		<Custom Action="CA_REMOVEARXPROPS" After="RemoveFiles"><![CDATA[REMOVE~="ALL"]]></Custom>
		<Custom Action="PreventDowngrading" After="FindRelatedProducts"><![CDATA[NEWERPRODUCTFOUND]]></Custom>
		<RemoveExistingProducts Before="InstallInitialize" /> 
	</InstallExecuteSequence>
	
	<CustomAction Id="CA_AdminUISequence" Property="InAdminUISequence" Value="1" Execute="firstSequence" />
	<AdminUISequence> <!-- msiexec /a (or ACTION=ADMIN) + full UI or reduced UI -->
		<Custom Action="CA_TARGETDIR" Before="CostInitialize"><![CDATA[TARGETDIR=""]]></Custom>
		<Custom Action="CA_AdminUISequence" Before="CostInitialize"></Custom>
		<Show Dialog="WelcomeForm" Before="CostFinalize"><![CDATA[Installed="" AND NOT RESUME]]></Show>
		<Show Dialog="ResumeForm" Before="CostFinalize"><![CDATA[Installed="" AND RESUME]]></Show>
		<Show Dialog="ProgressForm" Before="ExecuteAction" />		
		<Show Dialog="FatalErrorForm" OnExit="error"><![CDATA[NOT HideFatalErrorForm]]></Show>
		<Show Dialog="UserExitForm" OnExit="cancel" />
		<Show Dialog="AdminFinishedForm" OnExit="success" />
	</AdminUISequence>
	<AdminExecuteSequence>
		<Custom Action="CA_TARGETDIR" Before="CostInitialize"><![CDATA[TARGETDIR=""]]></Custom>
		<Custom Action="CA_PatchVSFiles" After="InstallFinalize"><![CDATA[REINSTALL OR NOT Installed]]></Custom>
		<Custom Action="CA_PatchHTMLWizFiles" After="InstallFinalize"><![CDATA[REINSTALL OR NOT Installed]]></Custom>
		<Custom Action="CA_PatchArxCommonJs" After="InstallFinalize"><![CDATA[REINSTALL OR NOT Installed]]></Custom>
	</AdminExecuteSequence>


	<CustomAction Id="PreventDowngrading" Error="Newer version already installed." /> <!-- Prevent downgrading -->
	<!-- 0.1.1 is a new product rather than an upgrade of the old 26.x line: the UpgradeCode changed
	     along with the numbering, so nothing from that line is looked for here. The two rows are the
	     standard pair - "a newer build is already installed" has no upper bound, and "an older build
	     is installed" runs from the start of this line up to, but not including, this build. Excluding
	     this build is what makes running setup again over the same version show the maintenance page
	     instead of removing and reinstalling itself. -->
	<Upgrade Id="$(var.UpgradeCode)">
		<UpgradeVersion Minimum="$(var.ProductVersion)" IncludeMinimum="no" OnlyDetect="yes" Property="NEWERPRODUCTFOUND" />
		<UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" Maximum="$(var.ProductVersion)" IncludeMaximum="no" OnlyDetect="no" Property="UPGRADEFOUND" />
		<!-- Detect for changes in 4th field only -->
		<!-- UpgradeVersion Minimum="$(var.version)" IncludeMinimum="yes" Maximum="$(var.version)" IncludeMaximum="yes" OnlyDetect="yes" Property="ANOTHERBUILDINSTALLED" / -->
	</Upgrade>	
	</Product>
</Wix>