			<Control Id="YEARBOX_2019" Type="CheckBox" X="18" Y="280" Width="88" Height="16" Property="YEAR_2019" Text="{\VSI_MS_Sans_Serif13.0_0_0}2019" TabSkip="no" CheckBoxValue="1" />
