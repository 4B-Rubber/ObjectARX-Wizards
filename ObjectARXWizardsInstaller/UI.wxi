				<Publish Property="YEAR_2024" Value="1"><![CDATA[ARXINV_2024<>"1"]]></Publish>
				<Publish Property="YEAR_2024" Value="{}"><![CDATA[ARXINV_2024="1"]]></Publish>
				<Publish Property="YEAR_2025" Value="1"><![CDATA[ARXINV_2025<>"1"]]></Publish>
