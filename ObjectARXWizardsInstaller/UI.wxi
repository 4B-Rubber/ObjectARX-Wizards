<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://schemas.microsoft.com/wix/2006/wi">

	<!-- The product ships Chinese-only (Product Codepage/Language 936/2052), so the strings below are
	     written in place. The Inno line can pick a language at run time; an MSI cannot - it carries one
	     language -, and the decision on this line was to keep the wizard Chinese rather than carry a
	     separate English package plus a transform. -->

	<Binary Id="DefBannerBitmap" SourceFile="Installerbitmaps\DefBannerBitmap.bmp" />
	<Binary Id="UpFldrBtn" SourceFile="Installerbitmaps\UpFldrBtn.ico" />
	<Binary Id="NewFldrBtn" SourceFile="Installerbitmaps\NewFldrBtn.ico" />

	<UI>	
		<TextStyle Id="VSI_MS_Sans_Serif13.0_0_0" FaceName="MS Sans Serif" Size="9" Red="0" Green="0" Blue="0" />
		<TextStyle Id="VSI_MS_Sans_Serif16.0_1_0" FaceName="MS Sans Serif" Size="12" Red="0" Green="0" Blue="0" Bold="yes" />
		<TextStyle Id="VsdDefaultUIFont.524F4245_5254_5341_4C45_534153783400" FaceName="MS Sans Serif" Size="9" Red="0" Green="0" Blue="0" />
		
		<!-- Start / End Dialogs -->
		<Dialog Id="WelcomeForm" X="50" Y="50" Width="373" Height="287" Title="[ProductName]">
			<Control Id="NextButton" Type="PushButton" X="300" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}下一步(&amp;N) &gt;" TabSkip="no" Default="yes">
				<Publish Event="EndDialog" Value="Return"><![CDATA[WelcomeForm_NextArgs=""]]></Publish>
				<Publish Event="NewDialog" Value="[WelcomeForm_NextArgs]"><![CDATA[WelcomeForm_NextArgs<>""]]></Publish>
			</Control>
			<Control Id="CancelButton" Type="PushButton" X="156" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}取消" TabSkip="no" Cancel="yes">
				<Publish Event="SpawnDialog" Value="Cancel" />
			</Control>
			<Control Id="PreviousButton" Type="PushButton" X="228" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}&lt; 上一步(&amp;B)" TabSkip="no">
				<Condition Action="disable"><![CDATA[WelcomeForm_PrevArgs=""]]></Condition>
				<Condition Action="enable"><![CDATA[WelcomeForm_PrevArgs<>""]]></Condition>
				<Publish Event="NewDialog" Value="[WelcomeForm_PrevArgs]"><![CDATA[WelcomeForm_PrevArgs<>""]]></Publish>
			</Control>
			<Control Id="BannerBmp" Type="Bitmap" X="0" Y="0" Width="375" Height="52" Text="DefBannerBitmap" TabSkip="no" Disabled="yes" />
			<Control Id="Line1" Type="Line" X="0" Y="52" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="Line2" Type="Line" X="0" Y="252" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="BannerText" Type="Text" X="9" Y="9" Width="306" Height="33" Text="{\VSI_MS_Sans_Serif16.0_1_0}欢迎使用 [ProductName] 安装程序" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
			<Control Id="CopyrightWarningText" Type="Text" X="9" Y="186" Width="354" Height="66" Text="{\VSI_MS_Sans_Serif13.0_0_0}警告：本计算机程序受著作权法及国际条约保护。未经授权复制或分发本程序或其任何部分，可能招致严厉的民事或刑事处罚，并将在法律允许的最大范围内被起诉。" TabSkip="yes" NoPrefix="yes" />
			<Control Id="WelcomeText" Type="Text" X="9" Y="63" Width="354" Height="114" Text="{\VSI_MS_Sans_Serif13.0_0_0}安装程序将引导您完成在本机安装 [ProductName] 所需的步骤。" TabSkip="yes" NoPrefix="yes">
				<Condition Action="show"><![CDATA[NOT(InAdminUISequence) OR (Installed="" AND NOT RESUME)]]></Condition>
				<Condition Action="hide"><![CDATA[InAdminUISequence AND (Installed<>"" OR RESUME)]]></Condition>
			</Control>
		</Dialog>
		
		<Dialog Id="ResumeForm" X="50" Y="50" Width="373" Height="287" Title="[ProductName]">
			<Control Id="FinishButton" Type="PushButton" X="300" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}完成(&amp;F)" TabSkip="no" Default="yes">
				<Publish Event="EndDialog" Value="Return">1</Publish>
			</Control>
			<Control Id="CancelButton" Type="PushButton" X="156" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}取消" TabSkip="no" Cancel="yes">
				<Publish Event="SpawnDialog" Value="Cancel" />
			</Control>
			<Control Id="PreviousButton" Type="PushButton" X="228" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}&lt; 上一步(&amp;B)" TabSkip="no" Disabled="yes" />
			<Control Id="BannerBmp" Type="Bitmap" X="0" Y="0" Width="375" Height="52" Text="DefBannerBitmap" TabSkip="no" Disabled="yes" />
			<Control Id="Line1" Type="Line" X="0" Y="52" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="Line2" Type="Line" X="0" Y="252" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="BannerText" Type="Text" X="9" Y="9" Width="306" Height="33" Text="{\VSI_MS_Sans_Serif16.0_1_0}欢迎使用 [ProductName] 安装向导" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
			<Control Id="BodyText" Type="Text" X="9" Y="63" Width="354" Height="180" Text="{\VSI_MS_Sans_Serif13.0_0_0}安装程序将恢复 [ProductName] 在本机上的安装。&#xD;&#xA;&#xD;&#xA;单击“完成”继续。" TabSkip="yes" NoPrefix="yes" />
		</Dialog>

		<RadioButtonGroup Property="MaintenanceForm_Action">
			<RadioButton Height="17" Text="{\VSI_MS_Sans_Serif13.0_0_0}修复 [ProductName](&amp;R)" Value="Repair" Width="348" X="0" Y="0" />
			<RadioButton Height="17" Text="{\VSI_MS_Sans_Serif13.0_0_0}更改目标 AutoCAD 版本并重新安装(&amp;C)" Value="Change" Width="348" X="0" Y="18" />
			<RadioButton Height="17" Text="{\VSI_MS_Sans_Serif13.0_0_0}删除 [ProductName](&amp;M)" Value="Remove" Width="348" X="0" Y="36" />
		</RadioButtonGroup>
		<Dialog Id="MaintenanceForm" X="50" Y="50" Width="373" Height="287" Title="[ProductName]">
			<Control Id="FinishButton" Type="PushButton" X="300" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}完成(&amp;F)" TabSkip="no" Default="yes">
				<!-- Repair reinstalls with the years already on disk; Change routes through SdkForm
				     first so a different set can be ticked. Both are a full REINSTALL. -->
				<Publish Property="REINSTALL" Value="ALL"><![CDATA[MaintenanceForm_Action<>"Remove"]]></Publish>
				<Publish Event="Reinstall" Value="ALL"><![CDATA[MaintenanceForm_Action<>"Remove"]]></Publish>
				<Publish Property="REMOVE" Value="ALL"><![CDATA[MaintenanceForm_Action="Remove"]]></Publish>
				<Publish Event="Remove" Value="ALL"><![CDATA[MaintenanceForm_Action="Remove"]]></Publish>
				<!-- SdkForm's check boxes start empty on this path (the year auto-tick lives on
				     ObjectARXForm's Next button, which maintenance mode never shows), so seed them
				     and make Back return here. -->
				<Publish Property="SdkForm_PrevArgs" Value="MaintenanceForm"><![CDATA[MaintenanceForm_Action="Change"]]></Publish>
				<Publish Event="DoAction" Value="CA_TickDetectedArxYears"><![CDATA[MaintenanceForm_Action="Change"]]></Publish>
				<Publish Event="NewDialog" Value="SdkForm"><![CDATA[MaintenanceForm_Action="Change"]]></Publish>
				<Publish Event="EndDialog" Value="Return"><![CDATA[MaintenanceForm_Action<>"Change"]]></Publish>
			</Control>
			<Control Id="RepairRadioGroup" Type="RadioButtonGroup" X="18" Y="108" Width="348" Height="54" Property="MaintenanceForm_Action" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiRadioButtonGroup" TabSkip="no" />
			<Control Id="CancelButton" Type="PushButton" X="156" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}取消" TabSkip="no" Cancel="yes">
				<Publish Event="SpawnDialog" Value="Cancel" />
			</Control>
			<Control Id="PreviousButton" Type="PushButton" X="228" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}&lt; 上一步(&amp;B)" TabSkip="no" Disabled="yes" />
			<Control Id="BannerBmp" Type="Bitmap" X="0" Y="0" Width="375" Height="52" Text="DefBannerBitmap" TabSkip="no" Disabled="yes" />
			<Control Id="Line1" Type="Line" X="0" Y="52" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="Line2" Type="Line" X="0" Y="252" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="BannerText" Type="Text" X="9" Y="9" Width="306" Height="33" Text="{\VSI_MS_Sans_Serif16.0_1_0}欢迎使用 [ProductName] 安装向导" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
			<Control Id="BodyText" Type="Text" X="9" Y="63" Width="354" Height="42" Text="{\VSI_MS_Sans_Serif13.0_0_0}请选择要修复 [ProductName]、更改目标 AutoCAD 版本并重新安装，还是将其删除。" TabSkip="yes" NoPrefix="yes" />
		</Dialog>
		
		<Dialog Id="FinishedForm" X="50" Y="50" Width="373" Height="287" Title="[ProductName]">
			<Control Id="CloseButton" Type="PushButton" X="300" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}关闭(&amp;C)" TabSkip="no" Default="yes" Cancel="yes">
				<Publish Event="EndDialog" Value="Return">1</Publish>
			</Control>
			<Control Id="CancelButton" Type="PushButton" X="156" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}取消" TabSkip="no" Disabled="yes" />
			<Control Id="PreviousButton" Type="PushButton" X="228" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}&lt; 上一步(&amp;B)" TabSkip="no" Disabled="yes" />
			<Control Id="BannerBmp" Type="Bitmap" X="0" Y="0" Width="375" Height="52" Text="DefBannerBitmap" TabSkip="no" Disabled="yes" />
			<Control Id="Line1" Type="Line" X="0" Y="52" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="Line2" Type="Line" X="0" Y="252" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="BannerText" Type="Text" X="9" Y="9" Width="306" Height="33" Text="{\VSI_MS_Sans_Serif16.0_1_0}安装完成" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
			<Control Id="BodyText" Type="Text" X="9" Y="63" Width="354" Height="138" Text="{\VSI_MS_Sans_Serif13.0_0_0}[ProductName] 已成功安装。&#xD;&#xA;&#xD;&#xA;单击“关闭”退出。" TabSkip="yes" NoPrefix="yes">
				<Condition Action="show"><![CDATA[REMOVE=""]]></Condition>
				<Condition Action="hide"><![CDATA[REMOVE<>""]]></Condition>
			</Control>
			<Control Id="BodyTextRemove" Type="Text" X="9" Y="63" Width="354" Height="138" Text="{\VSI_MS_Sans_Serif13.0_0_0}[ProductName] 已成功删除。&#xD;&#xA;&#xD;&#xA;单击“关闭”退出。" TabSkip="yes" NoPrefix="yes">
				<Condition Action="show"><![CDATA[REMOVE<>""]]></Condition>
				<Condition Action="hide"><![CDATA[REMOVE=""]]></Condition>
			</Control>
			<Control Id="UpdateText" Type="Text" X="9" Y="216" Width="354" Height="36" Text="{\VSI_MS_Sans_Serif13.0_0_0}" TabSkip="yes" NoPrefix="yes">
				<Condition Action="show"><![CDATA[REMOVE=""]]></Condition>
				<Condition Action="hide"><![CDATA[REMOVE<>""]]></Condition>
			</Control>
		</Dialog>

