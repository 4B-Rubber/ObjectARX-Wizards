				<Publish Property="YEAR_2027" Value="1"><![CDATA[ARXINV_2027<>"1"]]></Publish>
				<Publish Property="YEAR_2027" Value="{}"><![CDATA[ARXINV_2027="1"]]></Publish>
			</Control>
			<!-- One year per binary-compatible generation, so a project still loads into the other
			     AutoCAD releases sharing that SDK. 2017 is absent because the year table has no such
			     entry and 2018's props already covers 2017/2018 (both R22). -->
			<Control Id="CompatYearsButton" Type="PushButton" X="272" Y="135" Width="90" Height="16" Text="{\VSI_MS_Sans_Serif13.0_0_0}兼容(&amp;C)" TabSkip="no">
				<Publish Property="YEAR_2010" Value="{}">1</Publish>
				<Publish Property="YEAR_2012" Value="{}">1</Publish>
				<Publish Property="YEAR_2013" Value="{}">1</Publish>
