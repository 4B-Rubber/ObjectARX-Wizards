			<Control Id="BodyText" Type="Text" X="6" Y="9" Width="258" Height="24" Text="{\VSI_MS_Sans_Serif13.0_0_0}安装尚未完成。确定要退出吗？" TabSkip="yes" NoPrefix="yes" />
