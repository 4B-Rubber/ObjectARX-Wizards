			<Control Id="YEARBOX_2015" Type="CheckBox" X="18" Y="226" Width="88" Height="16" Property="YEAR_2015" Text="{\VSI_MS_Sans_Serif13.0_0_0}2015" TabSkip="no" CheckBoxValue="1" />
			<Control Id="YEARBOX_2016" Type="CheckBox" X="18" Y="244" Width="88" Height="16" Property="YEAR_2016" Text="{\VSI_MS_Sans_Serif13.0_0_0}2016" TabSkip="no" CheckBoxValue="1" />
