		<!-- System Dialogs -->
		<Dialog Id="ErrorDialog" X="50" Y="50" Width="330" Height="101" Title="[ProductName]" ErrorDialog="yes">
			<Control Id="ErrorText" Type="Text" X="6" Y="9" Width="318" Height="48" Text="{\VSI_MS_Sans_Serif13.0_0_0}" TabSkip="no" Disabled="yes" NoPrefix="yes" />
			<Control Id="N" Type="PushButton" X="120" Y="72" Width="81" Height="21" Text="{\VSI_MS_Sans_Serif13.0_0_0}否(&amp;N)" TabSkip="yes">
				<Publish Event="EndDialog" Value="ErrorNo" />
			</Control>
			<Control Id="Y" Type="PushButton" X="240" Y="72" Width="81" Height="21" Text="{\VSI_MS_Sans_Serif13.0_0_0}是(&amp;Y)" TabSkip="yes">
				<Publish Event="EndDialog" Value="ErrorYes" />
			</Control>
			<Control Id="A" Type="PushButton" X="0" Y="72" Width="81" Height="21" Text="{\VSI_MS_Sans_Serif13.0_0_0}退出安装(&amp;X)" TabSkip="yes">
				<Publish Event="EndDialog" Value="ErrorAbort" />
