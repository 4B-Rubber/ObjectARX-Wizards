			</Control>
		</Dialog>

		<!-- Where the year selection is read back. MSI binds a check box to its property only when the
		     dialog is created, so what the bulk buttons on SdkForm produced can only be shown on a page
		     built afterwards - here, from ARX_YEARS_SUMMARY. Back returns to SdkForm to adjust single
		     years, Next goes on to the confirmation page. -->
		<Dialog Id="YearSummaryForm" X="50" Y="50" Width="373" Height="287" Title="[ProductName]">
			<Control Id="NextButton" Type="PushButton" X="300" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}下一步(&amp;N) &gt;" TabSkip="no" Default="yes">
				<Publish Event="NewDialog" Value="ConfirmInstallForm">1</Publish>
			</Control>
			<Control Id="CancelButton" Type="PushButton" X="156" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}取消" TabSkip="no" Cancel="yes">
				<Publish Event="SpawnDialog" Value="Cancel" />
			</Control>
			<Control Id="PreviousButton" Type="PushButton" X="228" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}&lt; 上一步(&amp;B)" TabSkip="no">
				<Publish Event="NewDialog" Value="SdkForm">1</Publish>
			</Control>
			<Control Id="BannerBmp" Type="Bitmap" X="0" Y="0" Width="375" Height="52" Text="DefBannerBitmap" TabSkip="no" Disabled="yes" />
			<Control Id="Line1" Type="Line" X="0" Y="52" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="Line2" Type="Line" X="0" Y="252" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="BannerText" Type="Text" X="9" Y="9" Width="306" Height="33" Text="{\VSI_MS_Sans_Serif16.0_1_0}目标 AutoCAD 版本 - 所选内容" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
			<Control Id="SummaryText" Type="Text" X="18" Y="66" Width="340" Height="90" Text="{\VSI_MS_Sans_Serif13.0_0_0}[ARX_YEARS_SUMMARY]" TabSkip="yes" NoPrefix="yes" />
			<Control Id="HintText" Type="Text" X="18" Y="176" Width="340" Height="48" Text="{\VSI_MS_Sans_Serif13.0_0_0}按“上一步”回到上一页逐个勾选年份，或按“下一步”按当前所选安装。" TabSkip="yes" NoPrefix="yes" />
		</Dialog>

	</UI>
		
</Include>