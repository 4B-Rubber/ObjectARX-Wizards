				<Publish Property="YEAR_2015" Value="{}">1</Publish>
				<Publish Property="YEAR_2016" Value="1">1</Publish>
				<Publish Property="YEAR_2018" Value="1">1</Publish>
				<Publish Property="YEAR_2019" Value="{}">1</Publish>
				<Publish Property="YEAR_2020" Value="1">1</Publish>
				<Publish Property="YEAR_2021" Value="{}">1</Publish>
