		<!-- User Dialogs -->
		<!-- Where the wizards are installed. The MSI's TARGETDIR used to be a fixed (x86) folder with no
		     page at all; the Inno line made it selectable and moved it to the 64-bit Program Files, and
		     the property sheet folder follows it (see CA_DefaultPropsDir / ARXPROPSDIR_AUTO). -->
		<Dialog Id="InstallDirForm" X="50" Y="50" Width="373" Height="287" Title="[ProductName]">
			<Control Id="NextButton" Type="PushButton" X="300" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}下一步(&amp;N) &gt;" TabSkip="no" Default="yes">
				<!-- Keep the property sheet folder in step with the install folder, but only while it still
				     holds the value we put there ourselves (ARXPROPSDIR_AUTO): once the user typed a
				     folder of their own on SdkForm - or passed ARXPROPSDIR=... - the two differ and this
				     is skipped, so coming Back and pressing Next again cannot silently discard it. The
				     second publish records the new auto value; it has to come after the first, because
				     publishes run in order and this one would otherwise already move the target. -->
				<Publish Property="ARXPROPSDIR" Value="[TARGETDIR]"><![CDATA[ARXPROPSDIR="" OR ARXPROPSDIR="[ARXPROPSDIR_AUTO]"]]></Publish>
				<Publish Property="ARXPROPSDIR_AUTO" Value="[TARGETDIR]">1</Publish>
				<Publish Event="EndDialog" Value="Return"><![CDATA[InstallDirForm_NextArgs=""]]></Publish>
				<Publish Event="NewDialog" Value="[InstallDirForm_NextArgs]"><![CDATA[InstallDirForm_NextArgs<>""]]></Publish>
			</Control>
			<Control Id="CancelButton" Type="PushButton" X="156" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}取消" TabSkip="no" Cancel="yes">
				<Publish Event="SpawnDialog" Value="Cancel" />
			</Control>
			<Control Id="PreviousButton" Type="PushButton" X="228" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}&lt; 上一步(&amp;B)" TabSkip="no">
				<Condition Action="disable"><![CDATA[InstallDirForm_PrevArgs=""]]></Condition>
				<Condition Action="enable"><![CDATA[InstallDirForm_PrevArgs<>""]]></Condition>
				<Publish Event="NewDialog" Value="[InstallDirForm_PrevArgs]"><![CDATA[InstallDirForm_PrevArgs<>""]]></Publish>
			</Control>
			<Control Id="BannerBmp" Type="Bitmap" X="0" Y="0" Width="375" Height="52" Text="DefBannerBitmap" TabSkip="no" Disabled="yes" />
			<Control Id="Line1" Type="Line" X="0" Y="52" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="Line2" Type="Line" X="0" Y="252" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="BannerText" Type="Text" X="9" Y="9" Width="306" Height="33" Text="{\VSI_MS_Sans_Serif16.0_1_0}安装位置" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
			<Control Id="BodyText" Type="Text" X="9" Y="63" Width="354" Height="42" Text="{\VSI_MS_Sans_Serif13.0_0_0}请选择安装这套向导的文件夹。属性表目录默认跟随它，稍后也可以在下一页单独指定。" TabSkip="yes" NoPrefix="yes" />
			<Control Id="DirLabel" Type="Text" X="18" Y="118" Width="340" Height="12" Text="{\VSI_MS_Sans_Serif13.0_0_0}安装目录(&amp;D)：" TabSkip="no" />
			<Control Id="DirEdit" Type="PathEdit" X="18" Y="130" Width="252" Height="18" Property="TARGETDIR" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiPathEdit" TabSkip="no" Sunken="yes" />
			<Control Id="BrowseDir" Type="PushButton" X="275" Y="130" Width="90" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}浏览(&amp;R)..." TabSkip="no">
				<Publish Property="SelectFolderDialog_Property" Value="TARGETDIR">1</Publish>
				<Publish Event="SpawnDialog" Value="SelectFolderDialog">1</Publish>
			</Control>
		</Dialog>

		<Dialog Id="ObjectARXForm" X="50" Y="50" Width="373" Height="287" Title="[ProductName]">
                <Control Id="NextButton" Type="PushButton" X="300" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}下一步(&amp;N) &gt;" TabSkip="no" Default="yes">
                    <!-- On an upgrade, re-tick every year whose props already exist (i.e. the previous
                         selection). YEARS_DETECTED keeps Back/Next from re-applying it later. -->
                    <Publish Property="YEAR_2010" Value="1"><![CDATA[DET_YEAR_2010<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2012" Value="1"><![CDATA[DET_YEAR_2012<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2013" Value="1"><![CDATA[DET_YEAR_2013<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2014" Value="1"><![CDATA[DET_YEAR_2014<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2015" Value="1"><![CDATA[DET_YEAR_2015<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2016" Value="1"><![CDATA[DET_YEAR_2016<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2018" Value="1"><![CDATA[DET_YEAR_2018<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2019" Value="1"><![CDATA[DET_YEAR_2019<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2020" Value="1"><![CDATA[DET_YEAR_2020<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2021" Value="1"><![CDATA[DET_YEAR_2021<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2022" Value="1"><![CDATA[DET_YEAR_2022<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2023" Value="1"><![CDATA[DET_YEAR_2023<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2024" Value="1"><![CDATA[DET_YEAR_2024<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2025" Value="1"><![CDATA[DET_YEAR_2025<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2026" Value="1"><![CDATA[DET_YEAR_2026<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEAR_2027" Value="1"><![CDATA[DET_YEAR_2027<>"" AND NOT YEARS_DETECTED]]></Publish>
                    <Publish Property="YEARS_DETECTED" Value="1"><![CDATA[NOT YEARS_DETECTED]]></Publish>
                    <Publish Event="EndDialog" Value="Return"><![CDATA[ObjectARXForm_NextArgs=""]]></Publish>
                    <Publish Event="NewDialog" Value="[ObjectARXForm_NextArgs]"><![CDATA[ObjectARXForm_NextArgs<>""]]></Publish>
                </Control>
                <Control Id="RDSLabel" Type="Text" X="18" Y="108" Width="348" Height="12" Text="{\VSI_MS_Sans_Serif13.0_0_0}请输入默认的 RDS 符号（可留空）：" TabSkip="no" />
                <Control Id="RDSEdit" Type="Edit" X="18" Y="120" Width="348" Height="18" Property="RDS" Text="{\VSI_MS_Sans_Serif13.0_0_0}" TabSkip="no" Sunken="yes" />
                <Control Id="ArxLabel" Type="Text" X="18" Y="150" Width="348" Height="12" Text="{\VSI_MS_Sans_Serif13.0_0_0}ObjectARX SDK 位置（会往它的 inc 目录写文件）：" TabSkip="no" />
                <Control Id="ArxEdit" Type="PathEdit" X="18" Y="162" Width="252" Height="18" Property="ARXPATH" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiPathEdit" TabSkip="no" Sunken="yes" />
                <Control Id="BrowseArx" Type="PushButton" X="275" Y="162" Width="90" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}浏览(&amp;R)..." TabSkip="no">
                    <Publish Property="SelectFolderDialog_Property" Value="ARXPATH">1</Publish>
                    <Publish Event="SpawnDialog" Value="SelectFolderDialog">1</Publish>
                </Control>
                <Control Id="CancelButton" Type="PushButton" X="156" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}取消" TabSkip="no" Cancel="yes">
                    <Publish Event="SpawnDialog" Value="Cancel" />
                </Control>
                <Control Id="PreviousButton" Type="PushButton" X="228" Y="261" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}&lt; 上一步(&amp;B)" TabSkip="no">
                    <Condition Action="disable"><![CDATA[ObjectARXForm_PrevArgs=""]]></Condition>
                    <Condition Action="enable"><![CDATA[ObjectARXForm_PrevArgs<>""]]></Condition>
                    <Publish Event="NewDialog" Value="[ObjectARXForm_PrevArgs]"><![CDATA[ObjectARXForm_PrevArgs<>""]]></Publish>
                </Control>
                <Control Id="BannerBmp" Type="Bitmap" X="0" Y="0" Width="375" Height="52" Text="DefBannerBitmap" TabSkip="no" Disabled="yes" />
                <Control Id="BannerText" Type="Text" X="9" Y="9" Width="306" Height="33" Text="{\VSI_MS_Sans_Serif16.0_1_0}注册开发者符号 (RDS)" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="BodyText" Type="Text" X="9" Y="63" Width="354" Height="42" Text="{\VSI_MS_Sans_Serif13.0_0_0}请花一点时间指定创建新工程时默认使用的 RDS 符号，可以留空。关于 RDS 符号的说明见 http://www.autodesk.com/objectarx -&gt; 'Symbols Registration'" TabSkip="yes" NoPrefix="yes" />
                <Control Id="Control273" Type="Line" X="0" Y="252" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
                <Control Id="Control278" Type="Line" X="0" Y="52" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif16.0_1_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
            </Dialog>

	<!-- SDK roots + which AutoCAD years to generate. The props themselves are produced by the
		     ArxProps custom actions after InstallFiles, so nothing here is MSI payload. -->
		<!-- The bulk buttons set YEAR_* with declarative publishes, so they act on this dialog without
		     leaving it. Re-entering it would abort the install with error 2856 ("creating a second copy
		     of the dialog"), and a twin dialog is impossible because the CheckBox table is keyed by
		     Property: one property can back only one check box in the whole package. Next therefore
		     goes on to YearSummaryForm, which is where the selection can be read back as text. -->
		<Dialog Id="SdkForm" X="50" Y="50" Width="373" Height="370" Title="[ProductName]">
			<Control Id="NextButton" Type="PushButton" X="300" Y="348" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}下一步(&amp;N) &gt;" TabSkip="no" Default="yes">
				<!-- The selection is only reported as text on YearSummaryForm, which reads
				     ARX_YEARS_SUMMARY when it is created, so build it here. -->
				<Publish Event="DoAction" Value="CA_BuildYearsSummary">1</Publish>
				<Publish Event="EndDialog" Value="Return"><![CDATA[SdkForm_NextArgs=""]]></Publish>
				<Publish Event="NewDialog" Value="[SdkForm_NextArgs]"><![CDATA[SdkForm_NextArgs<>""]]></Publish>
			</Control>
			<Control Id="CancelButton" Type="PushButton" X="156" Y="348" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}取消" TabSkip="no" Cancel="yes">
				<Publish Event="SpawnDialog" Value="Cancel" />
			</Control>
			<Control Id="PreviousButton" Type="PushButton" X="228" Y="348" Width="66" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}&lt; 上一步(&amp;B)" TabSkip="no">
				<Condition Action="disable"><![CDATA[SdkForm_PrevArgs=""]]></Condition>
				<Condition Action="enable"><![CDATA[SdkForm_PrevArgs<>""]]></Condition>
				<Publish Event="NewDialog" Value="[SdkForm_PrevArgs]"><![CDATA[SdkForm_PrevArgs<>""]]></Publish>
			</Control>
			<Control Id="BannerBmp" Type="Bitmap" X="0" Y="0" Width="375" Height="52" Text="DefBannerBitmap" TabSkip="no" Disabled="yes" />
			<Control Id="Line1" Type="Line" X="0" Y="52" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="Line2" Type="Line" X="0" Y="340" Width="375" Height="6" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiHorizontalLine" TabSkip="yes" Disabled="yes" />
			<Control Id="BannerText" Type="Text" X="9" Y="9" Width="306" Height="33" Text="{\VSI_MS_Sans_Serif16.0_1_0}ObjectARX SDK 与目标版本" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
			<Control Id="BodyText" Type="Text" X="9" Y="59" Width="354" Height="30" Text="{\VSI_MS_Sans_Serif13.0_0_0}安装程序会为每个勾选的年份在属性表目录下各生成一份属性表。未勾选的年份不生成；勾选一个本机没装的年份没有副作用。" TabSkip="yes" NoPrefix="yes" />
			<Control Id="ArxRootLabel" Type="Text" X="18" Y="92" Width="240" Height="12" Text="{\VSI_MS_Sans_Serif13.0_0_0}Autodesk 根目录（SDK 与 AutoCAD 都在它下面）：" TabSkip="no" />
			<Control Id="ArxRootEdit" Type="PathEdit" X="18" Y="104" Width="252" Height="18" Property="ARXROOT" Text="{\VSI_MS_Sans_Serif13.0_0_0}MsiPathEdit" TabSkip="no" Sunken="yes" />
			<Control Id="BrowseArxRoot" Type="PushButton" X="275" Y="104" Width="90" Height="18" Text="{\VSI_MS_Sans_Serif13.0_0_0}浏览(&amp;R)..." TabSkip="no">
				<Publish Property="SelectFolderDialog_Property" Value="ARXROOT">1</Publish>
				<Publish Event="SpawnDialog" Value="SelectFolderDialog">1</Publish>
			</Control>
			<Control Id="YearLabel" Type="Text" X="18" Y="138" Width="96" Height="12" Text="{\VSI_MS_Sans_Serif13.0_0_0}AutoCAD 版本：" TabSkip="no" />
			<!-- Bulk selection is pure declarative publishing: no custom action and no page change, so the
			     check boxes stay where they are. A YEAR_* that is not ticked has to be EMPTY - MSI clears
			     a check box's property when it is cleared, and a non-empty value such as "0" renders as
			     ticked. Invert needs a pair per year because MSI cannot toggle a property on its own. -->
			<Control Id="AllYearsButton" Type="PushButton" X="128" Y="135" Width="44" Height="16" Text="{\VSI_MS_Sans_Serif13.0_0_0}全部(&amp;A)" TabSkip="no">
				<Publish Property="YEAR_2010" Value="1">1</Publish>
				<Publish Property="YEAR_2012" Value="1">1</Publish>
				<Publish Property="YEAR_2013" Value="1">1</Publish>
				<Publish Property="YEAR_2014" Value="1">1</Publish>
				<Publish Property="YEAR_2015" Value="1">1</Publish>
				<Publish Property="YEAR_2016" Value="1">1</Publish>
				<Publish Property="YEAR_2018" Value="1">1</Publish>
				<Publish Property="YEAR_2019" Value="1">1</Publish>
				<Publish Property="YEAR_2020" Value="1">1</Publish>
				<Publish Property="YEAR_2021" Value="1">1</Publish>
				<Publish Property="YEAR_2022" Value="1">1</Publish>
				<Publish Property="YEAR_2023" Value="1">1</Publish>
				<Publish Property="YEAR_2024" Value="1">1</Publish>
				<Publish Property="YEAR_2025" Value="1">1</Publish>
				<Publish Property="YEAR_2026" Value="1">1</Publish>
				<Publish Property="YEAR_2027" Value="1">1</Publish>
			</Control>
			<Control Id="NoYearsButton" Type="PushButton" X="174" Y="135" Width="44" Height="16" Text="{\VSI_MS_Sans_Serif13.0_0_0}全不选(&amp;N)" TabSkip="no">
				<Publish Property="YEAR_2010" Value="{}">1</Publish>
				<Publish Property="YEAR_2012" Value="{}">1</Publish>
				<Publish Property="YEAR_2013" Value="{}">1</Publish>
				<Publish Property="YEAR_2014" Value="{}">1</Publish>
				<Publish Property="YEAR_2015" Value="{}">1</Publish>
				<Publish Property="YEAR_2016" Value="{}">1</Publish>
				<Publish Property="YEAR_2018" Value="{}">1</Publish>
				<Publish Property="YEAR_2019" Value="{}">1</Publish>
				<Publish Property="YEAR_2020" Value="{}">1</Publish>
				<Publish Property="YEAR_2021" Value="{}">1</Publish>
				<Publish Property="YEAR_2022" Value="{}">1</Publish>
				<Publish Property="YEAR_2023" Value="{}">1</Publish>
				<Publish Property="YEAR_2024" Value="{}">1</Publish>
				<Publish Property="YEAR_2025" Value="{}">1</Publish>
				<Publish Property="YEAR_2026" Value="{}">1</Publish>
				<Publish Property="YEAR_2027" Value="{}">1</Publish>
			</Control>
			<Control Id="InvertYearsButton" Type="PushButton" X="220" Y="135" Width="50" Height="16" Text="{\VSI_MS_Sans_Serif13.0_0_0}反选(&amp;I)" TabSkip="no">
				<!-- Inverting reads each year's current value, and a publish pair that tests the very
				     property it is about to change cannot work: setting it to 1 makes the "clear it"
				     condition true as well, so both events fire and cancel out. Snapshot the selection
				     into ARXINV_* first, then flip against the snapshot. -->
				<Publish Property="ARXINV_2010" Value="[YEAR_2010]">1</Publish>
				<Publish Property="ARXINV_2012" Value="[YEAR_2012]">1</Publish>
				<Publish Property="ARXINV_2013" Value="[YEAR_2013]">1</Publish>
				<Publish Property="ARXINV_2014" Value="[YEAR_2014]">1</Publish>
				<Publish Property="ARXINV_2015" Value="[YEAR_2015]">1</Publish>
				<Publish Property="ARXINV_2016" Value="[YEAR_2016]">1</Publish>
				<Publish Property="ARXINV_2018" Value="[YEAR_2018]">1</Publish>
				<Publish Property="ARXINV_2019" Value="[YEAR_2019]">1</Publish>
				<Publish Property="ARXINV_2020" Value="[YEAR_2020]">1</Publish>
				<Publish Property="ARXINV_2021" Value="[YEAR_2021]">1</Publish>
				<Publish Property="ARXINV_2022" Value="[YEAR_2022]">1</Publish>
				<Publish Property="ARXINV_2023" Value="[YEAR_2023]">1</Publish>
				<Publish Property="ARXINV_2024" Value="[YEAR_2024]">1</Publish>
				<Publish Property="ARXINV_2025" Value="[YEAR_2025]">1</Publish>
				<Publish Property="ARXINV_2026" Value="[YEAR_2026]">1</Publish>
				<Publish Property="ARXINV_2027" Value="[YEAR_2027]">1</Publish>
				<Publish Property="YEAR_2010" Value="1"><![CDATA[ARXINV_2010<>"1"]]></Publish>
				<Publish Property="YEAR_2010" Value="{}"><![CDATA[ARXINV_2010="1"]]></Publish>
				<Publish Property="YEAR_2012" Value="1"><![CDATA[ARXINV_2012<>"1"]]></Publish>
				<Publish Property="YEAR_2012" Value="{}"><![CDATA[ARXINV_2012="1"]]></Publish>
				<Publish Property="YEAR_2013" Value="1"><![CDATA[ARXINV_2013<>"1"]]></Publish>
				<Publish Property="YEAR_2013" Value="{}"><![CDATA[ARXINV_2013="1"]]></Publish>
				<Publish Property="YEAR_2014" Value="1"><![CDATA[ARXINV_2014<>"1"]]></Publish>
				<Publish Property="YEAR_2014" Value="{}"><![CDATA[ARXINV_2014="1"]]></Publish>
				<Publish Property="YEAR_2015" Value="1"><![CDATA[ARXINV_2015<>"1"]]></Publish>
				<Publish Property="YEAR_2015" Value="{}"><![CDATA[ARXINV_2015="1"]]></Publish>
				<Publish Property="YEAR_2016" Value="1"><![CDATA[ARXINV_2016<>"1"]]></Publish>
				<Publish Property="YEAR_2016" Value="{}"><![CDATA[ARXINV_2016="1"]]></Publish>
				<Publish Property="YEAR_2018" Value="1"><![CDATA[ARXINV_2018<>"1"]]></Publish>
				<Publish Property="YEAR_2018" Value="{}"><![CDATA[ARXINV_2018="1"]]></Publish>
				<Publish Property="YEAR_2019" Value="1"><![CDATA[ARXINV_2019<>"1"]]></Publish>
				<Publish Property="YEAR_2019" Value="{}"><![CDATA[ARXINV_2019="1"]]></Publish>
				<Publish Property="YEAR_2020" Value="1"><![CDATA[ARXINV_2020<>"1"]]></Publish>
				<Publish Property="YEAR_2020" Value="{}"><![CDATA[ARXINV_2020="1"]]></Publish>
