<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://schemas.microsoft.com/wix/2006/wi">

	<Directory Id="TARGETDIR" Name="SourceDir" FileSource="..\">

		<!-- The property sheet folder. Multi-year generated projects import Autodesk.arx-YYYY.props
		     from here. ARXPROPSDIR is a directory id that CA_DefaultPropsDir seeds with TARGETDIR, so
		     the folder always follows the install folder (the Inno line does the same); the paths page
		     does not offer it.
		     Nothing ships in it: Autodesk.arx-<year>.props / -net.props are generated at install time
		     from the year table + skeleton (see the CreateArxProps custom action), and every other
		     .props file that used to travel here was an experiment of the authoring machine, never
		     something the wizards import. The component below therefore only creates the folder. -->
		<Directory Id="ProgramFiles64Folder">
			<Directory Id="D_AUTODESK_PF" Name="Autodesk">
				<Directory Id="ARXPROPSDIR" Name="ObjectARX Props" />
				<!-- Permanent, like the payload props used to be: uninstall leaves the folder behind,
				     because the generated sheets come back on the next install and an Autodesk SDK
				     installer may own the same folder. -->
				<Component Id="C_OBJARX_PROPS_GLOBAL" Guid="{7F3A2C91-4B6E-4D28-9A1C-7E5B0D8F6201}" Permanent="yes" Win64="yes" KeyPath="yes">
					<CreateFolder Directory="ARXPROPSDIR" />
				</Component>
					<!-- Records where the props folder ended up. The directory id above is the ARXPROPSDIR
					     property (SdkForm edits it), so costing writes the payload to the chosen folder;
					     the VSIX wizard and the legacy HTML wizard read this value to stay in sync. -->
				<Component Id="C_ARXPROPS_REG" Guid="{46B9D471-5B72-4428-A7A1-2C5D927E3A29}" Win64="yes">
					<RegistryValue Id="RV_ARXPROPSDIR" Root="HKLM" Key="SOFTWARE\Autodesk\ObjectARX Wizards" Name="PropsDir" Type="string" Value="[ARXPROPSDIR]" KeyPath="yes" />
					<!-- The install folder, so the next install pre-fills it instead of resetting to the
					     shipped default (read back by INSTALLDIR_PROBE). The Inno line writes and reads the
					     same value, so the two remember each other's choice. -->
					<RegistryValue Id="RV_INSTALLDIR" Root="HKLM" Key="SOFTWARE\Autodesk\ObjectARX Wizards" Name="InstallDir" Type="string" Value="[TARGETDIR]" />
					<!-- Remembered so the next install pre-fills the dialogs instead of resetting to the
					     shipped defaults (read back by ARXROOT_PROBE / ACADROOT_PROBE). ArxRoot carries the
					     ObjectARX SDK root, AcadRoot the Autodesk CAD root: this is a multi-year product, so
					     each is a parent and the generated sheets append the year themselves. -->
					<RegistryValue Id="RV_ARXROOT" Root="HKLM" Key="SOFTWARE\Autodesk\ObjectARX Wizards" Name="ArxRoot" Type="string" Value="[ARXROOT]" />
					<RegistryValue Id="RV_ACADROOT" Root="HKLM" Key="SOFTWARE\Autodesk\ObjectARX Wizards" Name="AcadRoot" Type="string" Value="[ACADROOT]" />
					<!-- The RDS the user picked, for the VSIX project wizard: it starts its RDS field from
					     this value (an empty value keeps the built-in ADSK). The Inno line records the same
					     value for the same reader. -->
					<RegistryValue Id="RV_RDS" Root="HKLM" Key="SOFTWARE\Autodesk\ObjectARX Wizards" Name="RDS" Type="string" Value="[RDS]" />
				</Component>
			</Directory>
		</Directory>
	</Directory>
</Include>
