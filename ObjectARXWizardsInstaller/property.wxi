<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://schemas.microsoft.com/wix/2006/wi">

    <Property Id="DefaultUIFont" Value="VsdDefaultUIFont.524F4245_5254_5341_4C45_534153783400" />
    <!-- UI default font -->
    <Property Id="ErrorDialog" Value="ErrorDialog" />
    <!-- Specify the ErrorDialog name in use in UI.wxi -->
    <Property Id="WelcomeForm_NextArgs" Value="InstallDirForm" />
    <Property Id="InstallDirForm_PrevArgs" Value="WelcomeForm" />
    <Property Id="InstallDirForm_NextArgs" Value="ObjectARXForm" />
    <Property Id="ObjectARXForm_PrevArgs" Value="InstallDirForm" />
    <Property Id="ObjectARXForm_NextArgs" Value="SdkForm" />
    <Property Id="SdkForm_PrevArgs" Value="ObjectARXForm" />
    <Property Id="SdkForm_NextArgs" Value="YearSummaryForm" />
    <Property Id="ConfirmInstallForm_PrevArgs" Value="YearSummaryForm" />
    <Property Id="MaintenanceForm_Action" Value="Repair" />
    <Property Id="AdminMaintenanceForm_Action" Value="Repair" />

    <!-- Where the wizards go. The previous install's folder wins over the shipped default, so an
         upgrade - or a switch between the MSI line and the Inno line, which writes the same value -
         does not make the user pick it again. INSTALLDIR_PROBE carries the remembered folder;
         CA_TARGETDIR still seeds the default when there is none. -->
    <Property Id="INSTALLDIR_PROBE" Secure="yes">
      <RegistrySearch Id="RS_INSTALLDIR" Root="HKLM" Key="SOFTWARE\Autodesk\ObjectARX Wizards" Name="InstallDir" Type="raw" Win64="yes" />
    </Property>
    <CustomAction Id="CA_TARGETDIR_PREV" Property="TARGETDIR" Value="[INSTALLDIR_PROBE]" Execute="firstSequence" />
    <CustomAction Id="CA_TARGETDIR" Property="TARGETDIR" Value="[ProgramFiles64Folder][Manufacturer]\[ProductName]" Execute="firstSequence" />
    <!-- The property sheet folder belongs to the install folder (the Inno line does the same), so it
         defaults to TARGETDIR, not to a fixed folder of its own. A directory property is only
         resolved at costing and our dialogs run before CostFinalize, so the value is seeded up front.
         ARXPROPSDIR_AUTO remembers the value we put there ourselves, which is how InstallDirForm can
         keep the two in step later without ever overwriting a folder the user chose: it only re-syncs
         while ARXPROPSDIR still equals ARXPROPSDIR_AUTO. This mirrors the Inno line's PropsAuto.
         A command line ARXPROPSDIR=... survives either way, because it is never equal to AUTO. -->
    <CustomAction Id="CA_DefaultPropsDir" Property="ARXPROPSDIR" Value="[TARGETDIR]" Execute="firstSequence" />
    <CustomAction Id="CA_DefaultPropsDirAuto" Property="ARXPROPSDIR_AUTO" Value="[TARGETDIR]" Execute="firstSequence" />
    <CustomAction Id="CA_DefaultArxRoot" Property="ARXROOT" Value="[ARXROOT_PROBE]" Execute="firstSequence" />
    <Property Id="ARXPATH" Value="C:\ObjectARX" Secure="yes"/>
    <!-- Optional: an empty RDS leaves the ADSK placeholder in the HTML wizard alone. That is exactly
         what PatchHTMLWizFiles does with an empty value (ADSK -> ADSK), so an empty default is safe
         and nothing is deleted from the shipped HTML pages. -->
    <Property Id="RDS" Secure="yes"/>

    <!--VS 2022-->
    <PropertyRef Id="VS2022_ROOT_FOLDER"/>

    <!-- ARP support -->
    <Property Id="ARPCOMMENTS" Value="Autodesk Developer Network" />
    <Property Id="ARPCONTACT" Value="by Cyrille Fauvel, Madhukar Moogala" />
    <Property Id="ARPPRODUCTICON" Value="ObjectARXWizards.ico" />
    <Property Id="ARPHELPLINK" Value="http://www.autodesk.com/developautocad" />
    <Property Id="ARPURLINFOABOUT" Value="http://www.autodesk.com/adn" />
    <Property Id="ARPURLUPDATEINFO" Value="http://www.autodesk.com/developautocad" />
    <Property Id="ARPHELPTELEPHONE" Value="  " />
    <Property Id="ARPSIZE" Value="1200" />

    <!-- ============================================================================
         Target-year selection (SdkForm). The Autodesk.arx-<year>.props files are no
         longer MSI payload: the ArxProps custom actions generate the ticked years at
         install time from the embedded year table + skeletons. Only DefaultYears is
         ticked by default; a year whose props already exist (an upgrade) is re-ticked
         by the AppSearch results regardless of that default.
         ============================================================================ -->
    <!-- The Autodesk root is user-selectable and remembered across installs, so an upgrade or a repair
         does not make the user type it again. It is the single root the SDK and AutoCAD share: this is
         a multi-year product, so the generated sheets append the year themselves
         ($(ArxSdkRoot)ObjectARX <year>\, <AcadRoot>AutoCAD <year>\). The PROBE property carries the
         previous value, or the default on a first install, and seeds the real property through the
         custom action below. -->
    <Property Id="ARXROOT" Secure="yes" />
    <Property Id="ARXROOT_PROBE" Value="C:\Program Files\Autodesk\" Secure="yes">
      <RegistrySearch Id="RS_ARXROOT" Root="HKLM" Key="SOFTWARE\Autodesk\ObjectARX Wizards" Name="ArxRoot" Type="raw" Win64="yes" />
    </Property>
    <!-- The props folder itself is user-selectable: ARXPROPSDIR is the directory id that holds the
         shared payload props, so costing resolves it and SdkForm can edit it (no <Property> needed).
         It defaults to the install folder (CA_DefaultPropsDir); ARXPROPSDIR_AUTO is the value we last
         put there ourselves, so InstallDirForm's Next can tell "still following" from "user chose
         something else" (see the CA_DefaultPropsDir comment).
         PROPSDIR_PROBE carries the *previous* props folder from the registry and feeds the year
         detection below, which runs before costing and therefore cannot use ARXPROPSDIR yet. -->
    <Property Id="ARXPROPSDIR_AUTO" Secure="yes" />
    <Property Id="PROPSDIR_PROBE" Value="C:\Program Files\Autodesk\ObjectARX Props" Secure="yes">
      <RegistrySearch Id="RS_ARXPROPSDIR" Root="HKLM" Key="SOFTWARE\Autodesk\ObjectARX Wizards" Name="PropsDir" Type="raw" Win64="yes" />
    </Property>
    <!-- Set only when a previous install recorded a props folder. Doubles as the "this is an
         upgrade, restore the previous year selection" marker for DefaultArxYears. -->
    <Property Id="PREV_PROPSDIR" Secure="yes">
      <RegistrySearch Id="RS_PREV_PROPSDIR" Root="HKLM" Key="SOFTWARE\Autodesk\ObjectARX Wizards" Name="PropsDir" Type="raw" Win64="yes" />
    </Property>

    <!-- All 16 year flags are authored secure but without a value. DefaultArxYears fills in the
         2018-2027 default on a first install only, so an upgrade keeps exactly the previous
         selection instead of unioning it with the default. -->
    <Property Id="YEAR_2010" Secure="yes" />
    <Property Id="YEAR_2012" Secure="yes" />
    <Property Id="YEAR_2013" Secure="yes" />
    <Property Id="YEAR_2014" Secure="yes" />
    <Property Id="YEAR_2015" Secure="yes" />
    <Property Id="YEAR_2016" Secure="yes" />
    <Property Id="YEAR_2018" Secure="yes" />
    <Property Id="YEAR_2019" Secure="yes" />
    <Property Id="YEAR_2020" Secure="yes" />
    <Property Id="YEAR_2021" Secure="yes" />
    <Property Id="YEAR_2022" Secure="yes" />
    <Property Id="YEAR_2023" Secure="yes" />
    <Property Id="YEAR_2024" Secure="yes" />
    <Property Id="YEAR_2025" Secure="yes" />
    <Property Id="YEAR_2026" Secure="yes" />
    <Property Id="YEAR_2027" Secure="yes" />

    <!-- Snapshot of YEAR_* taken by the Invert button before it flips anything. A pair of publishes
         that reads the property it is about to change cannot work: setting it to 1 makes the
         "clear it" condition true as well, so both events fire and cancel each other out. -->
    <Property Id="ARXINV_2010" Secure="yes" />
    <Property Id="ARXINV_2012" Secure="yes" />
    <Property Id="ARXINV_2013" Secure="yes" />
    <Property Id="ARXINV_2014" Secure="yes" />
    <Property Id="ARXINV_2015" Secure="yes" />
    <Property Id="ARXINV_2016" Secure="yes" />
    <Property Id="ARXINV_2018" Secure="yes" />
    <Property Id="ARXINV_2019" Secure="yes" />
    <Property Id="ARXINV_2020" Secure="yes" />
    <Property Id="ARXINV_2021" Secure="yes" />
    <Property Id="ARXINV_2022" Secure="yes" />
    <Property Id="ARXINV_2023" Secure="yes" />
    <Property Id="ARXINV_2024" Secure="yes" />
    <Property Id="ARXINV_2025" Secure="yes" />
    <Property Id="ARXINV_2026" Secure="yes" />
    <Property Id="ARXINV_2027" Secure="yes" />

    <!-- Read-only text for YearSummaryForm. CA_BuildYearsSummary fills it from YEAR_* when SdkForm's
         Next is pressed, because that page is the only place the selection can be read back. -->
    <Property Id="ARX_YEARS_SUMMARY" Value="（请在上一页选择目标版本）" Secure="yes" />

    <!-- DET_YEAR_<year> is set (to the found path) by AppSearch when that year's props exist,
         which means a previous install generated it. AppSearch precedes the dialogs. -->
    <Property Id="DET_YEAR_2010">
      <DirectorySearch Id="DS_YEAR_2010" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2010" Name="Autodesk.arx-2010.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2012">
      <DirectorySearch Id="DS_YEAR_2012" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2012" Name="Autodesk.arx-2012.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2013">
      <DirectorySearch Id="DS_YEAR_2013" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2013" Name="Autodesk.arx-2013.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2014">
      <DirectorySearch Id="DS_YEAR_2014" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2014" Name="Autodesk.arx-2014.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2015">
      <DirectorySearch Id="DS_YEAR_2015" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2015" Name="Autodesk.arx-2015.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2016">
      <DirectorySearch Id="DS_YEAR_2016" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2016" Name="Autodesk.arx-2016.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2018">
      <DirectorySearch Id="DS_YEAR_2018" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2018" Name="Autodesk.arx-2018.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2019">
      <DirectorySearch Id="DS_YEAR_2019" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2019" Name="Autodesk.arx-2019.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2020">
      <DirectorySearch Id="DS_YEAR_2020" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2020" Name="Autodesk.arx-2020.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2021">
      <DirectorySearch Id="DS_YEAR_2021" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2021" Name="Autodesk.arx-2021.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2022">
      <DirectorySearch Id="DS_YEAR_2022" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2022" Name="Autodesk.arx-2022.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2023">
      <DirectorySearch Id="DS_YEAR_2023" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2023" Name="Autodesk.arx-2023.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2024">
      <DirectorySearch Id="DS_YEAR_2024" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2024" Name="Autodesk.arx-2024.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2025">
      <DirectorySearch Id="DS_YEAR_2025" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2025" Name="Autodesk.arx-2025.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2026">
      <DirectorySearch Id="DS_YEAR_2026" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2026" Name="Autodesk.arx-2026.props" />
      </DirectorySearch>
    </Property>
    <Property Id="DET_YEAR_2027">
      <DirectorySearch Id="DS_YEAR_2027" Path="[PROPSDIR_PROBE]" Depth="0">
        <FileSearch Id="FS_YEAR_2027" Name="Autodesk.arx-2027.props" />
      </DirectorySearch>
    </Property>

    <!-- Under UAC elevation the client-side selection must reach the deferred ArxProps custom actions.
         WiX forbids authoring SecureCustomProperties / AdminProperties directly, so every public
         property above carries Secure="yes"; ARXPROPSDIR is a directory id, secured here.
         The CA_* properties carry CustomActionData for the deferred actions: PrepArxPropsData fills
         them at run time because a type-51 action cannot hold the result (255 character column cap). -->
    <Property Id="ARXPROPSDIR" Secure="yes" />
    <Property Id="CA_CREATEARXPROPS" Secure="yes" />
    <Property Id="CA_CLEANUPUNSELECTEDARXPROPS" Secure="yes" />
    <Property Id="CA_REMOVEARXPROPS" Secure="yes" />

</Include>