<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 调试输出：确认年份和开关状态 -->

  <!--
  <Target Name="CheckEnabledYears" BeforeTargets="Build">
    <Message Text="当前项目启用的年份：$(EnabledArxYears)" Importance="high" />
    <Message
      Text="开关状态 - Debug(d): $(EnableDebugConfigs)"
      Importance="high" />
  </Target>
  -->

  <!-- 项目配置分组：静态写法 + 开关控制，确保 VS 配置管理器完全兼容 -->
  <ItemGroup Label="ProjectConfigurations">
    <!-- 无后缀配置（默认动态库 Release） - 始终生成，只要年份启用 -->
    <ProjectConfiguration Include="2027|x64"
      Condition="$(EnabledArxYears.Contains('2027')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2027</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2026|x64"
      Condition="$(EnabledArxYears.Contains('2026')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2026</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2025|x64"
      Condition="$(EnabledArxYears.Contains('2025')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2025</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2024|x64"
      Condition="$(EnabledArxYears.Contains('2024')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2024</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2023|x64"
      Condition="$(EnabledArxYears.Contains('2023')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2023</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2022|x64"
      Condition="$(EnabledArxYears.Contains('2022')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2022</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2021|x64"
      Condition="$(EnabledArxYears.Contains('2021')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2021</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2020|x64"
      Condition="$(EnabledArxYears.Contains('2020')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2020</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2019|x64"
      Condition="$(EnabledArxYears.Contains('2019')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2019</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2018|x64"
      Condition="$(EnabledArxYears.Contains('2018')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2018</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2016|x64"
      Condition="$(EnabledArxYears.Contains('2016')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2016</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2015|x64"
      Condition="$(EnabledArxYears.Contains('2015')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2015</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2014|x64"
      Condition="$(EnabledArxYears.Contains('2014')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2014</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2013|x64"
      Condition="$(EnabledArxYears.Contains('2013')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2013</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>

    <!-- d 后缀配置（Debug 动态库） - 受 EnableDebugConfigs 开关控制 -->
    <ProjectConfiguration Include="2027d|x64"
      Condition="$(EnabledArxYears.Contains('2027')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2027d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2026d|x64"
      Condition="$(EnabledArxYears.Contains('2026')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2026d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2025d|x64"
      Condition="$(EnabledArxYears.Contains('2025')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2025d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2024d|x64"
      Condition="$(EnabledArxYears.Contains('2024')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2024d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2023d|x64"
      Condition="$(EnabledArxYears.Contains('2023')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2023d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2022d|x64"
      Condition="$(EnabledArxYears.Contains('2022')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2022d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2021d|x64"
      Condition="$(EnabledArxYears.Contains('2021')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2021d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2020d|x64"
      Condition="$(EnabledArxYears.Contains('2020')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2020d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2019d|x64"
      Condition="$(EnabledArxYears.Contains('2019')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2019d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2018d|x64"
      Condition="$(EnabledArxYears.Contains('2018')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2018d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2016d|x64"
      Condition="$(EnabledArxYears.Contains('2016')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2016d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2015d|x64"
      Condition="$(EnabledArxYears.Contains('2015')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2015d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2014d|x64"
      Condition="$(EnabledArxYears.Contains('2014')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2014d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2013d|x64"
      Condition="$(EnabledArxYears.Contains('2013')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2013d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- ===================================== 公共配置2：ArxYear & 后缀提取
  ===================================== -->
  <PropertyGroup>
    <ArxYear Condition="'$(Configuration)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(Configuration)','20(1[345689]|2[01234567])').Value)</ArxYear>
    <ConfigSuffix Condition="'$(Configuration)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(Configuration)','(d)$').Value)</ConfigSuffix>
    <IsDebug Condition="'$(ConfigSuffix)' == 'd'">true</IsDebug>
  </PropertyGroup>

  <!-- ===================================== 公共配置3：平台工具集 & 配置类型
  ===================================== -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <CLRSupport Condition="'$(ArxYear)' != '2027' and '$(ArxYear)' != '2026' and '$(ArxYear)' != '2025'">true</CLRSupport>
    <CLRSupport Condition="'$(ArxYear)' == '2027' or '$(ArxYear)' == '2026' or '$(ArxYear)' == '2025'">NetCore</CLRSupport>
    <UseOfMfc Condition="'$(ArxUseMfc)' != ''">$(ArxUseMfc)</UseOfMfc>
    <UseOfMfc Condition="'$(ArxUseMfc)' == ''">false</UseOfMfc>
    <!-- 平台工具集（按ArxYear自动切换） -->
    <PlatformToolset Condition="'$(ArxYear)' == '2027'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(ArxYear)' == '2026' or '$(ArxYear)' == '2025' or '$(ArxYear)' == '2024'">v143</PlatformToolset>
    <PlatformToolset Condition="'$(ArxYear)' == '2023' or '$(ArxYear)' == '2022' or '$(ArxYear)' == '2021'">v142</PlatformToolset>
    <PlatformToolset Condition="'$(ArxYear)' == '2020' or '$(ArxYear)' == '2019'">v141</PlatformToolset>
    <PlatformToolset Condition="'$(ArxYear)' == '2018'">v140</PlatformToolset>
    <PlatformToolset Condition="'$(ArxYear)' == '2016' or '$(ArxYear)' == '2015'">v110</PlatformToolset>
    <PlatformToolset Condition="'$(ArxYear)' == '2014' or '$(ArxYear)' == '2013'">v100</PlatformToolset>
    <UseDebugLibraries Condition="'$(IsDebug)' == 'true'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(IsDebug)' != 'true'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(IsDebug)' == 'true'">false</WholeProgramOptimization>
    <WholeProgramOptimization Condition="'$(IsDebug)' != 'true'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Condition="'$(ArxYear)' != ''" Project="Autodesk.arx-$(ArxYear).props" />
  </ImportGroup>

  <PropertyGroup Label="Globals">
    <TargetFramework Condition="'$(ArxYear)' == '2024' or 
                               '$(ArxYear)' == '2023' or 
                               '$(ArxYear)' == '2022' or 
                               '$(ArxYear)' == '2021' or 
                               '$(ArxYear)' == '2020' or 
                               '$(ArxYear)' == '2019' or 
                               '$(ArxYear)' == '2018' or 
                               '$(ArxYear)' == '2016' or 
                               '$(ArxYear)' == '2015'">v4.8</TargetFramework>
    <TargetFrameworkVersion Condition="'$(TargetFramework)' == 'v4.8'">v4.8</TargetFrameworkVersion>
    <TargetFramework Condition="'$(ArxYear)' == '2014' or '$(ArxYear)' == '2013'">v4.0</TargetFramework>
    <TargetFrameworkVersion Condition="'$(TargetFramework)' == 'v4.0'">v4.0</TargetFrameworkVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(ArxYear)' != ''and '$(ArxYear)' != '2027' and '$(ArxYear)' != '2026'and '$(ArxYear)' != '2025'">
    <Reference Include="AcCoreMgd">
      <HintPath>C:\Program Files\Autodesk\ObjectARX $(ArxYear)\inc\AcCoreMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>C:\Program Files\Autodesk\ObjectARX $(ArxYear)\inc\AcDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>C:\Program Files\Autodesk\ObjectARX $(ArxYear)\inc\AcMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ArxYear)' != ''">
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerDebuggerType Condition="'$(ArxYear)' == '2027' or '$(ArxYear)' == '2026' or '$(ArxYear)' == '2025'">NativeWithManagedCore</LocalDebuggerDebuggerType>
    <LocalDebuggerDebuggerType Condition="'$(ArxYear)' != '2027' and '$(ArxYear)' != '2026' and '$(ArxYear)' != '2025'">Mixed</LocalDebuggerDebuggerType>
  </PropertyGroup>

  <!-- ===================================== 公共配置5：目标名称 & 输出路径 ===================================== -->
  <PropertyGroup Condition="'$(ArxYear)' != ''">
    <IntDir>$(Platform)\$(Configuration)\</IntDir>
    <TargetName>$(ProjectName)$(ArxYear)</TargetName>
  </PropertyGroup>
  <!-- ===================================== 公共配置6：公共编译选项 ===================================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">_WIN64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(UseOfMfc)'=='Dynamic'"> _AFXEXT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SmallerTypeCheck>false</SmallerTypeCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <ExceptionHandling>Async</ExceptionHandling>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>