<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 调试输出：确认年份和开关状态 -->

  <!--
  <Target Name="CheckEnabledYears" BeforeTargets="Build">
    <Message Text="当前项目启用的年份：$(EnabledArxYears)" Importance="high" />
    <Message
      Text="开关状态 - Debug(d): $(EnableDebugConfigs)"
      Importance="high" />
  </Target>
  -->

  <!-- 项目配置分组：静态写法 + 开关控制，确保 VS 配置管理器完全兼容 -->
  <ItemGroup Label="ProjectConfigurations">
    <!-- 无后缀配置（默认动态库 Release） - 始终生成，只要年份启用 -->
    <ProjectConfiguration Include="2027|x64"
      Condition="$(EnabledArxYears.Contains('2027')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2027</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2026|x64"
      Condition="$(EnabledArxYears.Contains('2026')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2026</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2025|x64"
      Condition="$(EnabledArxYears.Contains('2025')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2025</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2024|x64"
      Condition="$(EnabledArxYears.Contains('2024')) and '$(EnabledArxYears)' != '' and '$(EnableReleaseConfigs)' == 'true'">
      <Configuration>2024</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>

    <!-- d 后缀配置（Debug 动态库） - 受 EnableDebugConfigs 开关控制 -->
    <ProjectConfiguration Include="2027d|x64"
      Condition="$(EnabledArxYears.Contains('2027')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2027d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2026d|x64"
      Condition="$(EnabledArxYears.Contains('2026')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2026d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2025d|x64"
      Condition="$(EnabledArxYears.Contains('2025')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2025d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="2024d|x64"
      Condition="$(EnabledArxYears.Contains('2024')) and '$(EnabledArxYears)' != '' and '$(EnableDebugConfigs)' == 'true'">
      <Configuration>2024d</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- ===================================== 公共配置2：ArxYear & 后缀提取
  ===================================== -->
  <PropertyGroup>
    <ArxYear Condition="'$(Configuration)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(Configuration)','20(2[4567])').Value)</ArxYear>
    <ConfigSuffix Condition="'$(Configuration)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(Configuration)','(d)$').Value)</ConfigSuffix>
    <IsDebug Condition="'$(ConfigSuffix)' == 'd'">true</IsDebug>
  </PropertyGroup>

  <!-- ===================================== 公共配置3：平台工具集 & 配置类型
  ===================================== -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <CLRSupport>true</CLRSupport>
    <UseOfMfc Condition="'$(ArxUseMfc)' != ''">$(ArxUseMfc)</UseOfMfc>
    <UseOfMfc Condition="'$(ArxUseMfc)' == ''">false</UseOfMfc>
    <!-- 平台工具集（按ArxYear自动切换） -->
    <PlatformToolset Condition="'$(ArxYear)' == '2027'">v141</PlatformToolset>
    <PlatformToolset Condition="'$(ArxYear)' == '2026' or '$(ArxYear)' == '2025' or '$(ArxYear)' == '2024'">v141</PlatformToolset>
    <UseDebugLibraries Condition="'$(IsDebug)' == 'true'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(IsDebug)' != 'true'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(IsDebug)' == 'true'">false</WholeProgramOptimization>
    <WholeProgramOptimization Condition="'$(IsDebug)' != 'true'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Condition="'$(ArxYear)' != ''" Project="ZWSoft.zrx-$(ArxYear).props" />
  </ImportGroup>

  <PropertyGroup Label="Globals">
    <TargetFramework Condition="'$(ArxYear)' == '2027' or 
                               '$(ArxYear)' == '2026' or 
                               '$(ArxYear)' == '2025' or 
                               '$(ArxYear)' == '2024'">v4.8</TargetFramework>
    <TargetFrameworkVersion Condition="'$(TargetFramework)' == 'v4.8'">v4.8</TargetFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ArxYear)' != ''">
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerDebuggerType>Mixed</LocalDebuggerDebuggerType>
  </PropertyGroup>

  <!-- ===================================== 公共配置5：目标名称 & 输出路径 ===================================== -->
  <PropertyGroup Condition="'$(ArxYear)' != ''">
    <IntDir>$(Platform)\$(Configuration)\</IntDir>
    <TargetName>$(ProjectName)$(ArxYear)</TargetName>
  </PropertyGroup>
  <!-- ===================================== 公共配置6：公共编译选项 ===================================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">_WIN64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions>ZWCAD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(UseOfMfc)'=='Dynamic'"> _AFXEXT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SmallerTypeCheck>false</SmallerTypeCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <ExceptionHandling>Async</ExceptionHandling>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>