<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="@@TOOLSVERSION@@" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- http://msdn.microsoft.com/en-us/library/ms171458.aspx -->
	<PropertyGroup>
		<_ProjectFileVersion>@@PFV@@</_ProjectFileVersion>
		<_PropertySheetDisplayName>ObjectARX @@YEAR@@</_PropertySheetDisplayName>
	</PropertyGroup>

@@USERIMPORT@@
	<PropertyGroup>
		<ArxSdkRoot Condition="'$(ArxSdkRoot)' == ''">@@SDKROOT@@</ArxSdkRoot>
		<AcadRoot Condition="'$(AcadRoot)' == ''">@@ACADROOT@@</AcadRoot>
	</PropertyGroup>
@@NO32COMMENT@@
	<PropertyGroup>
		<AcadDir Condition="'$(Platform)'=='x64' And '$(AcadDir)' == ''">$(AcadRoot)AutoCAD @@YEAR@@\</AcadDir>
@@WIN32ACAD@@
@@ACADEXE@@
		<ArxSdkDir Condition="'$(ArxSdkDir)' == ''">$(ArxSdkRoot)ObjectARX @@YEAR@@\</ArxSdkDir>
@@SDKINCS_WIN32@@
		<ArxSdkIncs Condition="'$(Platform)'=='x64'">$(ArxSdkDir)\inc;$(ArxSdkDir)\inc-x64</ArxSdkIncs>
		<ArxHlrIncs>$(ArxSdkDir)\utils\HlrApi\inc</ArxHlrIncs>
		<ArxAmodelerIncs>$(ArxSdkDir)\utils\amodeler\inc</ArxAmodelerIncs>
		<ArxBrepIncs>$(ArxSdkDir)\utils\brep\inc</ArxBrepIncs>
		<ArxAtilIncs>$(ArxSdkDir)\utils\Atil\Inc</ArxAtilIncs>
		<ArxAtilCodecPropIncs>$(ArxSdkDir)\utils\Atil\Inc\codec_properties</ArxAtilCodecPropIncs>
		<ArxAtilCodecFormatIncs>$(ArxSdkDir)\utils\Atil\Inc\format_codecs</ArxAtilCodecFormatIncs>
@@SDKLIBSS_WIN32@@
		<ArxSdkLibs Condition="'$(Platform)'=='x64'">$(ArxSdkDir)\lib-x64</ArxSdkLibs>
		<ArxHlrLibs>$(ArxSdkDir)\utils\HlrApi\lib-$(Platform)</ArxHlrLibs>
		<ArxAmodelerLibs>$(ArxSdkDir)\utils\amodeler\lib-$(Platform)</ArxAmodelerLibs>
		<ArxBrepLibs>$(ArxSdkDir)\utils\brep\lib-$(Platform)</ArxBrepLibs>
		<ArxAtilLibs>$(ArxSdkDir)\utils\Atil\Lib-$(Platform)</ArxAtilLibs>
		<ArxSDKVersion>@@SDKVERSION@@</ArxSDKVersion>
		<ArxSDKPlatform>@@TOOLSET@@</ArxSDKPlatform>
@@CRXTARGETEXT@@
	</PropertyGroup>

	<ImportGroup Label="PropertySheets">
		<Import Condition="'$(ArxAppType)'=='dbx' or '$(ArxAppType)'=='dbxnet'" Project="$(ArxSdkDir)\inc\dbx.props" />
@@CRXIMPORT@@
		<Import Condition="'$(ArxAppType)'=='arx' or '$(ArxAppType)'=='arxnet'" Project="$(ArxSdkDir)\inc\arx.props" />
		<Import Condition="'$(Configuration)'=='Release'or'$(Configuration)'=='@@YEAR@@'or'$(Configuration)'=='@@CFGB@@'or'$(Configuration)'=='@@CFGS@@'" Project="$(ArxSdkDir)\inc\rxsdk_Releasecfg.props" />
		<Import Condition="'$(Configuration)'=='Debug'or'$(Configuration)'=='@@CFGD@@'" Project="$(ArxSdkDir)\inc\rxsdk_Debugcfg.props" />
		<Import Condition="'$(ArxAppType)'=='dbxnet' or @@CRXNETCOND@@'$(ArxAppType)'=='arxnet'" Project="Autodesk.arx-@@YEAR@@-net.props" />
	</ImportGroup>
@@TF35BLOCK@@
	<!-- The v140 / v141 toolsets cannot resolve the "10.0" Windows SDK alias (MSB8036).
	     The resolver lives in its own sheet because every year imports it and it is the same
	     code for all of them; ObjectARX.WindowsSdk.props is generated next to this one. -->
	<Import Condition="Exists('$(MSBuildThisFileDirectory)ObjectARX.WindowsSdk.props')"
	        Project="$(MSBuildThisFileDirectory)ObjectARX.WindowsSdk.props" />

	<PropertyGroup>
		<!-- ExecutablePath>$(ExecutablePath)</ExecutablePath -->
		<IncludePath>$(ArxSdkIncs);$(ArxHlrIncs);$(ArxAmodelerIncs);$(ArxBrepIncs);$(ArxAtilIncs);$(ArxAtilCodecPropIncs);$(ArxAtilCodecFormatIncs);$(IncludePath)</IncludePath>
		<ReferencePath>$(ArxSdkIncs);$(ReferencePath)</ReferencePath>
		<LibraryPath>$(ArxSdkLibs);$(ArxHlrLibs);$(ArxAmodelerLibs);$(ArxBrepLibs);$(ArxAtilLibs);@@ARXLIBINCS@@$(LibraryPath)</LibraryPath>
		<!-- SourcePath>$(SourcePath)</SourcePath -->
		<!-- ExcludePath>$(ExcludePath)</ExcludePath -->
	</PropertyGroup>

	<PropertyGroup>
		<!-- Local Windows debugger -->
		<LocalDebuggerDebuggerType>Auto</LocalDebuggerDebuggerType>
		<!-- LocalDebuggerCommand is defined into an empty $(TargetPath) for the property page, it is later redefined to its proper value. -->
@@DBGCMD@@
		<LocalDebuggerWorkingDirectory>$(ProjectDir)</LocalDebuggerWorkingDirectory>
@@DBGCOMMENT@@
	</PropertyGroup>

	<ItemDefinitionGroup>
		<Midl>
			<AdditionalIncludeDirectories>%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
			<TypeLibraryName>$(IntDir)$(TargetName).tlb</TypeLibraryName>
			<HeaderFileName>%(Filename)_i.h</HeaderFileName>
			<InterfaceIdentifierFileName>%(Filename)_i.c</InterfaceIdentifierFileName>
		</Midl>
		<ClCompile>
			<PreprocessorDefinitions Condition="'$(ArxAppType)'=='dbx' or '$(ArxAppType)'=='dbxnet'">_DBXAPP;%(PreprocessorDefinitions)</PreprocessorDefinitions>
@@CRXDEF@@
			<PreprocessorDefinitions Condition="'$(ArxAppType)'=='arx' or '$(ArxAppType)'=='arxnet'">_ACRXAPP;%(PreprocessorDefinitions)</PreprocessorDefinitions>
			<AdditionalIncludeDirectories>%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
			<AdditionalUsingDirectories>$(ArxSdkDir)\inc-$(Platform);%(AdditionalUsingDirectories)</AdditionalUsingDirectories>
			<!-- Same defaults the stock ObjectARX projects carry (see ObjectARX.Common.props): every
			     year sheet is imported by every project, so an existing project picks these up as soon
			     as the installer regenerates the sheets. A project that sets them itself still wins -
			     the project's own item definitions come after the imported sheets. -->
			<SmallerTypeCheck>false</SmallerTypeCheck>
			<TreatWarningAsError>false</TreatWarningAsError>
			<MultiProcessorCompilation>true</MultiProcessorCompilation>
		</ClCompile>
		<ResourceCompile>
			<PreprocessorDefinitions>_UNICODE;UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
			<AdditionalIncludeDirectories>$(IntDir)</AdditionalIncludeDirectories>
		</ResourceCompile>
		<Link>
			<AdditionalDependencies>%(AdditionalDependencies)</AdditionalDependencies>
			<!-- ObjectARX 2021 and later ship the OMT geometry library separately and the SDK's own
			     support libraries do not link it, so it has to be added here rather than in a project
			     template: every project imports this year sheet, so projects that already exist pick
			     it up as soon as the installer regenerates the sheet. Keyed on the file itself - the
			     older SDKs do not have it and must not link it. -->
			<AdditionalDependencies Condition="Exists('$(ArxSdkLibs)\acgeoment.lib')">acgeoment.lib;%(AdditionalDependencies)</AdditionalDependencies>
@@CRXLIB@@
			<AdditionalLibraryDirectories>%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
@@TMWIN32@@
			<TargetMachine Condition="'$(Platform)'=='x64'">MachineX64</TargetMachine>
		</Link>
	</ItemDefinitionGroup>
</Project>